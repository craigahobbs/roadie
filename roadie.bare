# roadie.bare - The Roadie road grading plan 3D viewer MarkdownUp application

include <args.bare>
include <dataTable.bare>
include <schemaDoc.bare>
include 'roadieModel.bare'


# The application's URL arguments
roadieArguments = argsValidate([ \
    {'name': 'file', 'description': 'The road plan model JSON file URL'}, \
    {'name': 'option', 'type': 'int', 'default': 0, 'description': 'The selected road plan option index'}, \
    {'name': 'azimuth', 'type': 'float', 'default': 30, 'description': 'The 3D explorer view direction, in compass degrees'}, \
    {'name': 'tilt', 'type': 'float', 'default': 35, 'description': 'The 3D explorer view elevation angle, in degrees'}, \
    {'name': 'exaggeration', 'type': 'float', 'default': 1.5, 'description': 'The 3D explorer vertical exaggeration'}, \
    {'name': 'zoom', 'type': 'float', 'default': 1, 'description': 'The 3D explorer zoom factor (1 fits the site)'}, \
    {'name': 'x', 'type': 'float', 'description': 'The 3D explorer view center east coordinate (default is the site center)'}, \
    {'name': 'y', 'type': 'float', 'description': 'The 3D explorer view center north coordinate (default is the site center)'}, \
    {'name': 'z', 'type': 'float', 'description': 'The 3D explorer view center elevation (default is the ground elevation)'}, \
    {'name': 'explore', 'type': 'bool', 'default': false, 'explicit': true, 'description': 'Show the full-window 3D explorer'}, \
    {'name': 'smooth', 'type': 'bool', 'default': false, 'description': 'Draw the 3D terrain smoothly between its elevation grid points'}, \
    {'name': 'doc', 'type': 'bool', 'default': false, 'explicit': true, 'description': 'Show the model documentation'} \
])


# The cost score explanation
roadieScoreNote = 'The cost score is the estimated construction cost in thousands of nominal US dollars, ' + \
    'computed from typical unit rates. Use it to compare plan options, not as a bid estimate.'


# The application main entry point
async function roadieMain():
    args = argsParse(roadieArguments)
    file = objectGet(args, 'file')

    # Model documentation?
    if objectGet(args, 'doc'):
        documentSetTitle('Roadie Road Plan Model')
        markdownPrint(argsLink(roadieArguments, 'Back', {'doc': null}), '')
        markdownPrint(schemaDocMarkdown(roadieTypes, 'RoadPlan'))
        return
    endif

    # No plan file? Show the usage.
    if file == null:
        documentSetTitle('Roadie')
        markdownPrint( \
            '# Roadie', \
            '', \
            'Roadie is a 3D viewer for road grading plan models. A road grading plan model contains the site', \
            'topography, the road start and end points, and one or more road plan options.', \
            '', \
            'To create a road plan model from a topographic map image, run:', \
            '', \
            '~~~', \
            'make plan FILE=<plan.png>', \
            '~~~', \
            '', \
            'To view a road plan model, run:', \
            '', \
            '~~~', \
            'make run FILE=<plan.json>', \
            '~~~', \
            '', \
            'Or, view a road plan model URL with the "file" argument: [Example](#var.vFile=\'example/example.json\')', \
            '', \
            argsLink(roadieArguments, 'Road plan model documentation', {'doc': true}) \
        )
        return
    endif

    # Load the road plan model
    planText = systemFetch(file)
    planValue = if(planText != null, jsonParse(planText))
    if planValue == null:
        documentSetTitle('Roadie')
        markdownPrint('# Roadie', '', '**Error:** Could not load the road plan "' + markdownEscape(file) + '"')
        return
    endif
    validated = roadieValidate(planValue)
    if objectHas(validated, 'error'):
        documentSetTitle('Roadie')
        markdownPrint('# Roadie', '', '**Error:** The road plan "' + markdownEscape(file) + '" is invalid:', '', \
            markdownEscape(objectGet(validated, 'error')))
        return
    endif

    # Render the road plan report, or the 3D explorer
    if objectGet(args, 'explore'):
        roadieExplore(args, objectGet(validated, 'plan'))
    else:
        roadieRender(args, objectGet(validated, 'plan'))
    endif
endfunction


# The maximum view width, in pixels
roadieMaxWidth = 1200


# Compute the view width for the window width, in pixels
function roadieViewWidth():
    return mathMax(400, mathMin(roadieMaxWidth, windowWidth() - 3 * documentFontSize()))
endfunction


# The window resize handler - re-render the road plan when the view width changes
function roadieOnResize(args, plan):
    if roadieViewWidth() != systemGlobalGet('roadieRenderWidth'):
        roadieRender(args, plan)
    endif
endfunction


# The session storage key of the current page's token. MarkdownUp doesn't remove a page's document keydown handler
# when the app navigates to another page, so the 3D explorer's key handler does nothing unless its page is current.
roadiePageTokenKey = 'roadiePageToken'


# Create a new page token, making it the current page's token
function roadieNewPageToken():
    previous = sessionStorageGet(roadiePageTokenKey)
    token = '' + (if(previous != null, numberParseInt(previous), 0) + 1)
    sessionStorageSet(roadiePageTokenKey, token)
    return token
endfunction


# Render a road plan
function roadieRender(args, plan):
    roadieNewPageToken()
    file = objectGet(args, 'file')
    units = objectGet(plan, 'units')
    options = objectGet(plan, 'options')
    ixOption = mathMax(0, mathMin(arrayLength(options) - 1, objectGet(args, 'option')))
    option = arrayGet(options, ixOption)
    topo = roadieTopo(plan)
    width = roadieViewWidth()
    systemGlobalSet('roadieRenderWidth', width)
    windowSetResize(systemPartial(roadieOnResize, args, plan))

    # Analyze the options
    analyses = []
    ixAnalyze = 0
    while ixAnalyze < arrayLength(options):
        arrayPush(analyses, roadieAnalyze(plan, ixAnalyze, topo))
        ixAnalyze = ixAnalyze + 1
    endwhile
    analysis = arrayGet(analyses, ixOption)

    # Title and description
    documentSetTitle(objectGet(plan, 'title'))
    markdownPrint('# ' + markdownEscape(objectGet(plan, 'title')), '')
    if objectHas(plan, 'description'):
        markdownPrint(objectGet(plan, 'description'), '')
    endif

    # Options comparison
    markdownPrint('## Plan Options', '')
    markdownPrint(roadieOptionsTable(plan, analyses, ixOption), '')

    # The selected option
    markdownPrint('## ' + markdownEscape(objectGet(option, 'name')), '')
    if objectHas(option, 'description'):
        markdownPrint(objectGet(option, 'description'), '')
    endif
    warnings = objectGet(analysis, 'warnings')
    markdownPrint( \
        '**Cost score: ' + roadieNumber(objectGet(analysis, 'score'), 0) + '** - ' + \
            roadieNumber(objectGet(analysis, 'length'), 0) + ' ' + roadieUnitLabel(units, 'length') + ', ' + \
            numberToFixed(objectGet(analysis, 'maxGrade'), 1) + '% maximum grade, ' + \
            arrayLength(warnings) + ' design warning' + if(arrayLength(warnings) == 1, '', 's'), \
        '' \
    )

    # The 3D views - the whole site, then views along the road from its start to its end, as needed
    halfWidth = objectGet(objectGet(option, 'section'), 'width') * 0.5
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), halfWidth)
    smooth = objectGet(args, 'smooth')
    reportViews = roadieReportViews(topo, rows, analysis, halfWidth, width, smooth)
    outlines = []
    for reportView, ixReportView in reportViews:
        if ixReportView > 0:
            middle = roadieSampleAt(objectGet(analysis, 'samples'), \
                (objectGet(reportView, 'station') + objectGet(reportView, 'endStation')) * 0.5)
            arrayPush(outlines, ['' + (ixReportView + 1), objectGet(reportView, 'view'), [objectGet(middle, 'x'), objectGet(middle, 'y')]])
        endif
    endfor

    # Plan view
    markdownPrint('### Plan View', '')
    if arrayLength(outlines) > 0:
        markdownPrint('The numbered markers show the road segments of 3D views 2 through ' + arrayLength(reportViews) + \
            ', below - the dashed outlines show the areas they cover.', '')
    endif
    elementModelRender(roadiePlanView(plan, topo, analyses, ixOption, width, outlines))

    # Profile
    markdownPrint('### Profile', '')
    elementModelRender(roadieProfileView(plan, option, analysis, width, 320))

    # 3D views
    exploreArgs = objectAssign({'explore': true}, objectGet(arrayGet(reportViews, 0), 'args'))
    markdownPrint('### 3D Views', '', \
        argsLink(roadieArguments, 'Explore the plan in 3D', exploreArgs) + ' (full window, with keyboard controls)', '', \
        roadieTerrainLinks(smooth), '')
    for reportView, ixReportView in reportViews:
        markdownPrint(roadieViewCaption(units, reportView, ixReportView, arrayLength(reportViews)), '')
        elementModelRender(roadieView3D(plan, topo, rows, ixOption, analysis, objectGet(reportView, 'view')))
    endfor

    # Cost breakdown
    markdownPrint('### Cost', '', roadieScoreNote, '')
    markdownPrint(roadieCostTable(units, analysis), '')

    # Design warnings
    markdownPrint('### Design Warnings', '')
    if arrayLength(warnings) == 0:
        markdownPrint('No design warnings.', '')
    else:
        for warning in warnings:
            markdownPrint('- ' + markdownEscape(warning))
        endfor
        markdownPrint('')
    endif

    # Structures
    if objectGet(option, 'structures'):
        markdownPrint('### Structures', '')
        markdownPrint(roadieStructuresTable(units, option, analysis), '')
    endif

    # Source topographic map image
    image = objectGet(plan, 'image')
    if image != null:
        ixSlash = stringLastIndexOf(file, '/')
        imageURL = if(ixSlash == -1, image, stringSlice(file, 0, ixSlash + 1) + image)
        markdownPrint('### Source Map', '')
        elementModelRender({'html': 'p', 'elem': {'html': 'img', 'attr': { \
            'src': documentURL(urlEncode(imageURL)), \
            'alt': 'The source topographic map', \
            'style': 'max-width: 100%; height: auto;' \
        }}})
    endif

    # Footer
    markdownPrint('---', '', argsLink(roadieArguments, 'Road plan model documentation', {'doc': true}))
endfunction


# The maximum 3D view zoom factor
roadieMaxZoom = 64


#
# Report 3D views
#


# The report 3D views' vertical exaggeration
roadieReportExaggeration = 1.5


# The road width, in pixels, that the report's road segment views aim to draw
roadieReportRoadPx = 6


# The maximum number of report road segment views
roadieMaxSegmentViews = 6


# The number of road points checked for visibility in each report view
roadieVisibilityPoints = 32


# Choose the report's 3D views - an overview of the whole site, then, if the road is too narrow to see in the
# overview or the terrain hides parts of it, views of equal road segments from the start to the end. The overview
# looks across the road's overall direction from its start to its end, from the side looking upslope (where the road's
# cuts into the hillsides and its fill slopes face the viewer). The segment views keep the overview's general
# orientation, so the reader stays oriented across the views - each turns toward its segment's own crosswise
# direction, up to roadieMaxViewTurn degrees. Each view uses the lowest tilt that shows all of its road. Returns an
# array of report view objects ("args", "view", "station", "endStation", "hidden", and "leftToRight").
function roadieReportViews(topo, rows, analysis, halfWidth, width, smooth):
    maxHeight = mathRound(width * 0.75)
    samples = objectGet(analysis, 'samples')
    length = objectGet(analysis, 'length')
    finishedTopo = objectCopy(topo)
    objectSet(finishedTopo, 'rows', rows)

    # The overview - the whole site, fit to its terrain
    viewpoint = roadieChooseViewpoint(topo, finishedTopo, samples, 0, length, [55, 70, 90], null)
    terrainPoints = []
    nRows = objectGet(topo, 'nRows')
    nCols = objectGet(topo, 'nCols')
    spacing = objectGet(topo, 'spacing')
    step = mathMax(1, mathCeil(mathMax(nRows, nCols) / 40))
    for row in roadieGridSteps(nRows, step):
        for col in roadieGridSteps(nCols, step):
            arrayPush(terrainPoints, [col * spacing, (nRows - 1 - row) * spacing, arrayGet(arrayGet(rows, row), col)])
        endfor
    endfor
    overviewArgs = roadieFitViewpoint(topo, terrainPoints, viewpoint, width, maxHeight)
    objectSet(overviewArgs, 'smooth', smooth)
    views = [roadieReportView(topo, samples, 0, length, viewpoint, overviewArgs, width, maxHeight)]
    overview = objectGet(arrayGet(views, 0), 'view')
    if 2 * halfWidth * objectGet(overview, 'scale') >= roadieReportRoadPx && objectGet(viewpoint, 'hidden') == 0:
        return views
    endif

    # The road segment views - each about one and a half view widths of road at the target road width
    baseAzimuth = objectGet(viewpoint, 'azimuth')
    segmentLength = 1.5 * width * 2 * halfWidth / roadieReportRoadPx
    count = mathMax(1, mathMin(roadieMaxSegmentViews, mathCeil(length / segmentLength)))
    ixSegment = 0
    while ixSegment < count:
        station = length * ixSegment / count
        endStation = length * (ixSegment + 1) / count
        viewpoint = roadieChooseViewpoint(topo, finishedTopo, samples, station, endStation, [40, 55, 70, 90], baseAzimuth)
        footprint = []
        for sample in roadieSegmentSamples(samples, station, endStation):
            arrayExtend(footprint, roadieSamplePoints(sample, halfWidth))
        endfor
        viewArgs = roadieFitViewpoint(topo, footprint, viewpoint, width, maxHeight)
        objectSet(viewArgs, 'smooth', smooth)
        arrayPush(views, roadieReportView(topo, samples, station, endStation, viewpoint, viewArgs, width, maxHeight))
        ixSegment = ixSegment + 1
    endwhile
    return views
endfunction


# The maximum turn of a report segment view from the overview's direction, in degrees
roadieMaxViewTurn = 40


# Get a grid dimension's indexes at a step, always including the last index
function roadieGridSteps(count, step):
    indexes = []
    index = 0
    while index < count - 1:
        arrayPush(indexes, index)
        index = index + step
    endwhile
    arrayPush(indexes, count - 1)
    return indexes
endfunction


# Create a report view object - the road runs left to right if its segment's end is right of its start
function roadieReportView(topo, samples, station, endStation, viewpoint, viewArgs, width, maxHeight):
    view = roadieProjection(topo, viewArgs, width, maxHeight)
    first = roadieSampleAt(samples, station)
    last = roadieSampleAt(samples, endStation)
    firstPoint = roadieProject(view, objectGet(first, 'x'), objectGet(first, 'y'), objectGet(first, 'z'))
    lastPoint = roadieProject(view, objectGet(last, 'x'), objectGet(last, 'y'), objectGet(last, 'z'))
    return { \
        'args': viewArgs, \
        'view': view, \
        'station': station, \
        'endStation': endStation, \
        'hidden': objectGet(viewpoint, 'hidden'), \
        'leftToRight': arrayGet(lastPoint, 0) >= arrayGet(firstPoint, 0) \
    }
endfunction


# Get the road samples within a station range
function roadieSegmentSamples(samples, station, endStation):
    segment = []
    for sample in samples:
        sampleStation = objectGet(sample, 'station')
        if sampleStation >= station - 1e-6 && sampleStation <= endStation + 1e-6:
            arrayPush(segment, sample)
        endif
    endfor
    return segment
endfunction


# Compute the signed difference of two angles, in degrees (-180 to 180)
function roadieAngleDifference(angle, otherAngle):
    return (angle - otherAngle + 540) % 360 - 180
endfunction


# Choose a road segment's viewpoint - returns an object with the "azimuth" and "tilt" (degrees) and the number of hidden
# road points ("hidden"). The viewpoint looks across the segment's direction of travel. Without a base azimuth (the
# overview), it looks from the side looking upslope (or, on flat ground, the side with the start on the left).
# Otherwise, it looks from the base azimuth's side, turned at most roadieMaxViewTurn degrees from the base azimuth - or
# along the base azimuth itself. The lowest tilt that shows all of the road points wins - otherwise, the viewpoint
# hiding the fewest.
function roadieChooseViewpoint(topo, finishedTopo, samples, station, endStation, tilts, baseAzimuth):
    segment = roadieSegmentSamples(samples, station, endStation)
    first = arrayGet(segment, 0)
    last = arrayGet(segment, arrayLength(segment) - 1)
    travelX = objectGet(last, 'x') - objectGet(first, 'x')
    travelY = objectGet(last, 'y') - objectGet(first, 'y')
    if mathSqrt(travelX * travelX + travelY * travelY) < objectGet(topo, 'spacing') * 1e-3:
        travelX = objectGet(first, 'dx')
        travelY = objectGet(first, 'dy')
    endif
    leftAzimuth = mathAtan2(travelX, travelY) * 180 / mathPi() - 90

    # The road points to check, and the average uphill direction
    points = []
    uphillX = 0
    uphillY = 0
    pointStep = mathMax(1, mathFloor(arrayLength(segment) / roadieVisibilityPoints))
    for sample, ixSample in segment:
        if ixSample % pointStep == 0 || ixSample == arrayLength(segment) - 1:
            x = objectGet(sample, 'x')
            y = objectGet(sample, 'y')
            arrayPush(points, [x, y, objectGet(sample, 'z')])
            gradient = roadieGradient(topo, x, y)
            uphillX = uphillX + arrayGet(gradient, 0)
            uphillY = uphillY + arrayGet(gradient, 1)
        endif
    endfor

    # The candidate azimuths, in order of preference
    if baseAzimuth == null:
        # Looking to the left of travel puts the start on the left - prefer the side looking upslope
        leftRadians = leftAzimuth * mathPi() / 180
        upslope = (mathSin(leftRadians) * uphillX + mathCos(leftRadians) * uphillY) / arrayLength(points)
        azimuths = if(upslope >= -0.02, [leftAzimuth, leftAzimuth + 180], [leftAzimuth + 180, leftAzimuth])
    else:
        # The crosswise direction on the base azimuth's side, turned at most roadieMaxViewTurn degrees from it
        turn = roadieAngleDifference(leftAzimuth, baseAzimuth)
        turn = if(mathAbs(turn) > 90, roadieAngleDifference(leftAzimuth + 180, baseAzimuth), turn)
        turn = mathMax(-roadieMaxViewTurn, mathMin(roadieMaxViewTurn, turn))
        azimuths = [baseAzimuth + turn, baseAzimuth]
    endif

    best = null
    for tilt in tilts:
        for azimuth in azimuths:
            azimuth = mathRound((azimuth + 720) % 360, 1)
            hidden = roadieHiddenPoints(finishedTopo, points, azimuth, tilt, roadieReportExaggeration)
            if best == null || hidden < objectGet(best, 'hidden'):
                best = {'azimuth': azimuth, 'tilt': tilt, 'hidden': hidden}
            endif
            if hidden == 0:
                return best
            endif
        endfor
    endfor
    return best
endfunction


# Count the road points ([x, y, z] arrays) hidden by the terrain from a viewpoint - each point's view ray is followed
# toward the viewer until it rises above the terrain or leaves the topography
function roadieHiddenPoints(topo, points, azimuth, tilt, exaggeration):
    if tilt >= 89.9:
        return 0
    endif
    radians = azimuth * mathPi() / 180
    towardX = -mathSin(radians)
    towardY = -mathCos(radians)
    rise = mathTan(tilt * mathPi() / 180) / exaggeration
    spacing = objectGet(topo, 'spacing')
    maxZ = objectGet(topo, 'maxZ')
    tolerance = spacing * 0.02
    hidden = 0
    for point in points:
        x = arrayGet(point, 0)
        y = arrayGet(point, 1)
        z = arrayGet(point, 2)
        distance = spacing
        while z + distance * rise <= maxZ:
            ground = roadieElevation(topo, x + towardX * distance, y + towardY * distance)
            if ground == null:
                break
            endif
            if ground > z + distance * rise + tolerance:
                hidden = hidden + 1
                break
            endif
            distance = distance + spacing
        endwhile
    endfor
    return hidden
endfunction


# Fit points ([x, y, z] arrays) in a report view - returns the view arguments for a viewpoint that center the points in
# the view, zoomed so they fill most of it
function roadieFitViewpoint(topo, points, viewpoint, width, maxHeight):
    sumX = 0
    sumY = 0
    sumZ = 0
    for point in points:
        sumX = sumX + arrayGet(point, 0)
        sumY = sumY + arrayGet(point, 1)
        sumZ = sumZ + arrayGet(point, 2)
    endfor
    count = arrayLength(points)
    viewArgs = { \
        'azimuth': objectGet(viewpoint, 'azimuth'), \
        'tilt': objectGet(viewpoint, 'tilt'), \
        'exaggeration': roadieReportExaggeration, \
        'zoom': 1, \
        'x': sumX / count, \
        'y': sumY / count, \
        'z': sumZ / count \
    }

    # The points' pixel extent in the unzoomed view
    view = roadieProjection(topo, viewArgs, width, maxHeight)
    coords = arrayGet(roadieProjectPoints(view, points), 0)
    pxMin = arrayGet(coords, 0)
    pxMax = pxMin
    pyMin = arrayGet(coords, 1)
    pyMax = pyMin
    ixCoord = 2
    while ixCoord < arrayLength(coords):
        pxMin = mathMin(pxMin, arrayGet(coords, ixCoord))
        pxMax = mathMax(pxMax, arrayGet(coords, ixCoord))
        pyMin = mathMin(pyMin, arrayGet(coords, ixCoord + 1))
        pyMax = mathMax(pyMax, arrayGet(coords, ixCoord + 1))
        ixCoord = ixCoord + 2
    endwhile

    # Move the view center to the points' center - right along the view's x axis, and forward along the ground
    scale = objectGet(view, 'scale')
    right = ((pxMin + pxMax) * 0.5 - width * 0.5) / scale
    forward = (objectGet(view, 'cy') - (pyMin + pyMax) * 0.5) / scale / objectGet(view, 'sinTilt')
    cosAz = objectGet(view, 'cosAz')
    sinAz = objectGet(view, 'sinAz')
    objectSet(viewArgs, 'x', mathRound(objectGet(viewArgs, 'x') + right * cosAz + forward * sinAz, 1))
    objectSet(viewArgs, 'y', mathRound(objectGet(viewArgs, 'y') - right * sinAz + forward * cosAz, 1))
    objectSet(viewArgs, 'z', mathRound(objectGet(viewArgs, 'z'), 1))
    zoom = mathMin(0.85 * width / mathMax(pxMax - pxMin, 1e-9), 0.8 * maxHeight / mathMax(pyMax - pyMin, 1e-9))
    objectSet(viewArgs, 'zoom', mathRound(mathMax(1, mathMin(roadieMaxZoom, zoom)), 3))
    return viewArgs
endfunction


# Create the report's terrain links Markdown text - the current terrain drawing is bold
function roadieTerrainLinks(smooth):
    return 'Terrain: ' + if(smooth, argsLink(roadieArguments, 'Faceted', {'smooth': null}), '**Faceted**') + ' | ' + \
        if(smooth, '**Smooth**', argsLink(roadieArguments, 'Smooth', {'smooth': true})) + \
        ' - faceted terrain is the plan\'s elevation grid; smooth terrain is interpolated between its points, so it looks ' + \
        'smoother up close but is no more accurate'
endfunction


# The compass point names, clockwise from north
roadieCompassPoints = ['north', 'north-northeast', 'northeast', 'east-northeast', 'east', 'east-southeast', 'southeast', \
    'south-southeast', 'south', 'south-southwest', 'southwest', 'west-southwest', 'west', 'west-northwest', 'northwest', \
    'north-northwest']


# Create a report 3D view's caption Markdown text
function roadieViewCaption(units, reportView, ixView, viewCount):
    viewArgs = objectGet(reportView, 'args')
    azimuth = objectGet(viewArgs, 'azimuth')
    direction = arrayGet(roadieCompassPoints, mathRound(azimuth / 22.5) % 16)
    if ixView == 0:
        caption = '**View 1 of ' + viewCount + ': Overview** - the whole site'
    else:
        caption = '**View ' + (ixView + 1) + ' of ' + viewCount + '** - stations ' + \
            roadieStation(objectGet(reportView, 'station'), units) + ' to ' + roadieStation(objectGet(reportView, 'endStation'), units)
    endif
    caption = caption + ', looking ' + direction + ' (' + numberToFixed(azimuth, 0) + '°) from ' + \
        numberToFixed(objectGet(viewArgs, 'tilt'), 0) + '° above the horizon. The road runs ' + \
        if(objectGet(reportView, 'leftToRight'), 'left to right', 'right to left') + ' from its start to its end'
    if objectGet(reportView, 'hidden') > 0:
        caption = caption + ' - the terrain hides parts of the road' + if(ixView == 0 && viewCount > 1, ', shown in the views that follow', '')
    endif
    return caption + '. ' + argsLink(roadieArguments, 'Explore this view', objectAssign({'explore': true}, viewArgs))
endfunction


#
# 3D explorer
#


# The 3D explorer's reset anchor element ID
roadieExploreAnchor = 'roadie-explore'


# The 3D explorer's keyboard help lines
roadieExploreHelp = [ \
    'Arrows or W A S D - move', \
    '+ / - - zoom in / out', \
    'Q / E or Shift+Left / Right - rotate', \
    'Shift+Up / Down - tilt (view from above / from the side)', \
    'R / F or Page Up / Down - raise / lower', \
    '[ / ] - less / more vertical exaggeration', \
    'G - smooth / faceted terrain', \
    'T - top view, N - face north, 0 - reset', \
    'H - hide this help, Esc - back to the report' \
]


# The 3D explorer's view argument names
roadieExploreViewArgs = ['azimuth', 'tilt', 'exaggeration', 'zoom', 'x', 'y', 'z', 'smooth']


# Render the full-window 3D explorer - its view is moved with the keyboard
function roadieExplore(args, plan):
    context = roadieExploreContext(args, plan)
    documentSetTitle(objectGet(plan, 'title') + ' - 3D')
    elementModelRender({'html': 'div', 'attr': {'id': roadieExploreAnchor, 'style': 'display: none;'}})
    documentSetKeyDown(systemPartial(roadieExploreOnKeyDown, context))
    windowSetResize(systemPartial(roadieExploreRender, context))
    roadieExploreRender(context)
endfunction


# Create the 3D explorer's context object - the plan, its analysis and finished grade rows, and the view state (the view
# arguments and whether the keyboard help is shown)
function roadieExploreContext(args, plan):
    options = objectGet(plan, 'options')
    ixOption = mathMax(0, mathMin(arrayLength(options) - 1, objectGet(args, 'option')))
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, ixOption, topo)
    halfWidth = objectGet(objectGet(arrayGet(options, ixOption), 'section'), 'width') * 0.5
    state = {'help': true}
    for name in roadieExploreViewArgs:
        objectSet(state, name, objectGet(args, name))
    endfor
    return { \
        'token': roadieNewPageToken(), \
        'plan': plan, \
        'topo': topo, \
        'rows': roadieFinishedRows(topo, objectGet(analysis, 'samples'), halfWidth), \
        'ixOption': ixOption, \
        'analysis': analysis, \
        'initial': objectCopy(state), \
        'state': state, \
        'view': null \
    }
endfunction


# The 3D explorer's back-to-the-report URL arguments - the report keeps the terrain drawing
function roadieExploreBackArgs(state):
    backArgs = {'explore': null}
    for name in roadieExploreViewArgs:
        objectSet(backArgs, name, null)
    endfor
    objectSet(backArgs, 'smooth', if(objectGet(state, 'smooth'), true))
    return backArgs
endfunction


# Render the 3D explorer's view, filling the window
function roadieExploreRender(context):
    state = objectGet(context, 'state')
    plan = objectGet(context, 'plan')
    topo = objectGet(context, 'topo')
    fontSize = documentFontSize()
    width = mathMax(320, windowWidth() - 3 * fontSize)
    height = mathMax(240, windowHeight() - 3 * fontSize)
    viewArgs = objectCopy(state)
    objectSet(viewArgs, 'fill', true)
    view = roadieProjection(topo, viewArgs, width, height)
    objectSet(context, 'view', view)
    svg = roadieView3D(plan, topo, objectGet(context, 'rows'), objectGet(context, 'ixOption'), objectGet(context, 'analysis'), view)

    # The full-window view has no margins
    attr = objectGet(svg, 'attr')
    objectSet(attr, 'style', stringReplace(objectGet(attr, 'style'), 'margin: 0.75em 0 1.5em 0;', 'margin: 0;'))

    # The overlays - the report link, the keyboard help, and the view status
    elements = objectGet(svg, 'elem')
    arrayPush(elements, {'svg': 'a', 'attr': {'href': argsURL(roadieArguments, roadieExploreBackArgs(state))}, \
        'elem': roadieSvgText('Back to the report', 12, 20, 14, 'start', '#1f4e8c', true)})
    helpLines = if(objectGet(state, 'help'), roadieExploreHelp, ['H - keyboard help'])
    helpTop = height - 36 - 18 * arrayLength(helpLines)
    arrayPush(elements, {'svg': 'rect', 'attr': {'x': 8, 'y': helpTop - 6, 'width': 380, \
        'height': 18 * arrayLength(helpLines) + 8, 'rx': 4, 'fill': 'white', 'fill-opacity': 0.75}})
    for line, ixLine in helpLines:
        arrayPush(elements, roadieSvgText(line, 16, helpTop + 7 + 18 * ixLine, 12, 'start', '#222', false))
    endfor
    status = 'Center x ' + roadieNumber(objectGet(view, 'xc'), 0) + ', y ' + roadieNumber(objectGet(view, 'yc'), 0) + \
        ', z ' + roadieNumber(objectGet(view, 'zc'), 0) + ' ' + roadieUnitLabel(objectGet(plan, 'units'), 'length') + \
        ' - zoom ' + mathRound(objectGet(view, 'zoom'), 2) + 'x, rotation ' + mathRound(objectGet(state, 'azimuth'), 1) + \
        ', tilt ' + mathRound(objectGet(state, 'tilt'), 1) + ', exaggeration ' + mathRound(objectGet(state, 'exaggeration'), 2) + \
        'x, ' + if(objectGet(state, 'smooth'), 'smooth', 'faceted') + ' terrain'
    arrayPush(elements, roadieSvgText(status, 12, height - 14, 12, 'start', '#222', false))

    documentSetReset(roadieExploreAnchor)
    elementModelRender(svg)
endfunction


# Compute the next zoom step (by the square root of two) in a direction (1 is in, -1 is out)
function roadieZoomStep(zoom, direction):
    zoomStep = mathRound(2 * mathLog(zoom, 2)) + direction
    return mathMax(1, mathMin(roadieMaxZoom, mathRound(2 ** (zoomStep / 2), 3)))
endfunction


# The 3D explorer's key down handler
function roadieExploreOnKeyDown(context, event):
    # Ignore the keys of a page that's no longer current (without session storage, the page is assumed current) and
    # leave the browser's shortcuts alone
    token = sessionStorageGet(roadiePageTokenKey)
    if (token != null && token != objectGet(context, 'token')) || \
            objectGet(event, 'ctrlKey') || objectGet(event, 'metaKey') || objectGet(event, 'altKey'):
        return
    endif
    key = objectGet(event, 'key')
    code = objectGet(event, 'code')
    shift = objectGet(event, 'shiftKey')
    state = objectGet(context, 'state')
    view = objectGet(context, 'view')
    topo = objectGet(context, 'topo')

    # Back to the report
    if code == 'Escape':
        windowSetLocation(argsURL(roadieArguments, roadieExploreBackArgs(state)))
        return
    endif

    # The keys - the arrow keys move, or with shift, rotate and tilt
    moveRight = 0
    moveForward = 0
    moveUp = 0
    if (code == 'ArrowLeft' && !shift) || code == 'KeyA':
        moveRight = -1
    elif (code == 'ArrowRight' && !shift) || code == 'KeyD':
        moveRight = 1
    elif (code == 'ArrowUp' && !shift) || code == 'KeyW':
        moveForward = 1
    elif (code == 'ArrowDown' && !shift) || code == 'KeyS':
        moveForward = -1
    elif code == 'KeyR' || code == 'PageUp':
        moveUp = 1
    elif code == 'KeyF' || code == 'PageDown':
        moveUp = -1
    elif key == '+' || key == '=':
        objectSet(state, 'zoom', roadieZoomStep(objectGet(state, 'zoom'), 1))
    elif key == '-' || key == '_':
        objectSet(state, 'zoom', roadieZoomStep(objectGet(state, 'zoom'), -1))
    elif code == 'KeyQ' || code == 'ArrowLeft':
        objectSet(state, 'azimuth', (objectGet(state, 'azimuth') + 350) % 360)
    elif code == 'KeyE' || code == 'ArrowRight':
        objectSet(state, 'azimuth', (objectGet(state, 'azimuth') + 10) % 360)
    elif code == 'ArrowUp':
        objectSet(state, 'tilt', mathMin(90, objectGet(state, 'tilt') + 5))
    elif code == 'ArrowDown':
        objectSet(state, 'tilt', mathMax(5, objectGet(state, 'tilt') - 5))
    elif key == '[':
        objectSet(state, 'exaggeration', mathMax(1, objectGet(state, 'exaggeration') - 0.25))
    elif key == ']':
        objectSet(state, 'exaggeration', mathMin(5, objectGet(state, 'exaggeration') + 0.25))
    elif code == 'KeyG':
        objectSet(state, 'smooth', !objectGet(state, 'smooth'))
    elif code == 'KeyT':
        objectSet(state, 'tilt', 90)
    elif code == 'KeyN':
        objectSet(state, 'azimuth', 0)
    elif key == '0' || code == 'Home':
        objectAssign(state, objectGet(context, 'initial'))
    elif code == 'KeyH' || key == '?':
        objectSet(state, 'help', !objectGet(state, 'help'))
    else:
        return
    endif

    # Move the view center an eighth of the view's width (left, right, forward, and back) or height (up and down) -
    # the moved center keeps its elevation
    if moveRight != 0 || moveForward != 0 || moveUp != 0:
        scale = objectGet(view, 'scale')
        stepXY = objectGet(view, 'width') / 8 / scale
        stepZ = objectGet(view, 'height') / 8 / (scale * objectGet(state, 'exaggeration'))
        cosAz = objectGet(view, 'cosAz')
        sinAz = objectGet(view, 'sinAz')
        x = objectGet(view, 'xc') + (moveRight * cosAz + moveForward * sinAz) * stepXY
        y = objectGet(view, 'yc') + (moveForward * cosAz - moveRight * sinAz) * stepXY
        objectSet(state, 'x', mathRound(mathMax(0, mathMin(objectGet(topo, 'width'), x)), 1))
        objectSet(state, 'y', mathRound(mathMax(0, mathMin(objectGet(topo, 'height'), y)), 1))
        objectSet(state, 'z', mathRound(objectGet(view, 'zc') + moveUp * stepZ, 1))
    endif
    roadieExploreRender(context)
endfunction


# The plan view click handler - open the 3D explorer centered on the clicked ground point, zoomed in 4x
function roadieOnPlanClick(topo, svgWidth, svgHeight, pad, scale, px, py, renderWidth, renderHeight):
    x = mathMax(0, mathMin(objectGet(topo, 'width'), (px * svgWidth / renderWidth - pad) / scale))
    y = mathMax(0, mathMin(objectGet(topo, 'height'), objectGet(topo, 'height') - (py * svgHeight / renderHeight - pad) / scale))
    windowSetLocation(argsURL(roadieArguments, {'explore': true, 'x': mathRound(x, 1), 'y': mathRound(y, 1), 'z': null, 'zoom': 4}))
endfunction


# Create the options comparison table Markdown lines
function roadieOptionsTable(plan, analyses, ixOption):
    units = objectGet(plan, 'units')
    lengthUnit = roadieUnitLabel(units, 'length')
    volumeUnit = roadieUnitLabel(units, 'volume')
    areaUnit = roadieUnitLabel(units, 'area')

    # Find the lowest score
    minScore = null
    for analysis in analyses:
        minScore = if(minScore == null, objectGet(analysis, 'score'), mathMin(minScore, objectGet(analysis, 'score')))
    endfor

    rows = []
    for analysis, ixAnalysis in analyses:
        name = markdownEscape(objectGet(analysis, 'name'))
        borrow = objectGet(analysis, 'borrow')
        waste = objectGet(analysis, 'waste')
        net = if(borrow > 0, roadieNumber(roadieDisplayQuantity(units, 'volume', borrow), 0) + ' import', \
            roadieNumber(roadieDisplayQuantity(units, 'volume', waste), 0) + ' export')
        arrayPush(rows, { \
            'Option': if(ixAnalysis == ixOption, '**' + name + '**', argsLink(roadieArguments, name, {'option': ixAnalysis})), \
            'Length (' + lengthUnit + ')': roadieNumber(objectGet(analysis, 'length'), 0), \
            'Max Grade': numberToFixed(objectGet(analysis, 'maxGrade'), 1) + '%', \
            'Cut (' + volumeUnit + ')': roadieNumber(roadieDisplayQuantity(units, 'volume', objectGet(analysis, 'cut')), 0), \
            'Fill (' + volumeUnit + ')': roadieNumber(roadieDisplayQuantity(units, 'volume', objectGet(analysis, 'fill')), 0), \
            'Net (' + volumeUnit + ')': net, \
            'Walls (' + areaUnit + ')': roadieNumber(objectGet(analysis, 'wallArea'), 0), \
            'Warnings': '' + arrayLength(objectGet(analysis, 'warnings')), \
            'Cost Score': '**' + roadieNumber(objectGet(analysis, 'score'), 0) + '**', \
            'Relative': if(minScore > 0, '+' + numberToFixed(100 * (objectGet(analysis, 'score') / minScore - 1), 0) + '%', '') \
        })
    endfor
    return dataTableMarkdown(rows, { \
        'fields': objectKeys(arrayGet(rows, 0)), \
        'formats': { \
            'Option': {'markdown': true}, \
            'Cost Score': {'markdown': true, 'align': 'right'} \
        } \
    })
endfunction


# Create the cost breakdown table Markdown lines
function roadieCostTable(units, analysis):
    total = objectGet(analysis, 'total')
    rows = []
    for cost in objectGet(analysis, 'costs'):
        if objectGet(cost, 'cost') > 0:
            type = objectGet(cost, 'type')
            arrayPush(rows, { \
                'Item': objectGet(cost, 'name'), \
                'Quantity': if(type != null, roadieNumber(roadieDisplayQuantity(units, type, objectGet(cost, 'quantity')), 0) + ' ' + \
                    roadieUnitLabel(units, type), ''), \
                'Cost Score': roadieNumber(objectGet(cost, 'cost') / 1000, 1), \
                'Share': numberToFixed(100 * objectGet(cost, 'cost') / total, 1) + '%' \
            })
        endif
    endfor
    arrayPush(rows, {'Item': '**Total**', 'Quantity': '', 'Cost Score': '**' + roadieNumber(total / 1000, 1) + '**', 'Share': ''})
    return dataTableMarkdown(rows, { \
        'fields': ['Item', 'Quantity', 'Cost Score', 'Share'], \
        'formats': { \
            'Item': {'markdown': true}, \
            'Quantity': {'align': 'right'}, \
            'Cost Score': {'markdown': true, 'align': 'right'}, \
            'Share': {'align': 'right'} \
        } \
    })
endfunction


# Create the structures table Markdown lines
function roadieStructuresTable(units, option, analysis):
    samples = objectGet(analysis, 'samples')
    lengthUnit = roadieUnitLabel(units, 'length')
    rows = []
    for structure in objectGet(option, 'structures'):
        type = objectGet(structure, 'type')
        station = objectGet(structure, 'station')
        endStation = objectGet(structure, 'endStation')
        detail = ''
        if type == 'retainingWall':
            maxHeight = 0
            for sample in samples:
                if objectGet(sample, 'station') >= station && objectGet(sample, 'station') <= endStation:
                    maxHeight = mathMax(maxHeight, objectGet(objectGet(sample, 'left'), 'wall'), objectGet(objectGet(sample, 'right'), 'wall'))
                endif
            endfor
            detail = 'Maximum height ' + numberToFixed(maxHeight, 1) + ' ' + lengthUnit
        elif type == 'culvert':
            detail = 'Diameter ' + mathRound(roadieCulvertDiameter(units, structure), 2) + ' ' + lengthUnit
        elif type == 'bridge':
            detail = 'Span ' + numberToFixed(endStation - station, 0) + ' ' + lengthUnit
        elif type == 'existingRoad':
            detail = 'Upgrade ' + roadieNumber(endStation - station, 0) + ' ' + lengthUnit
        endif
        arrayPush(rows, { \
            'Type': objectGet(roadieStructureNames, type), \
            'Name': objectGet(structure, 'name', ''), \
            'Station': roadieStation(station, units) + if(endStation != null, ' to ' + roadieStation(endStation, units), ''), \
            'Side': objectGet(structure, 'side', if(type == 'retainingWall', 'both', if(type == 'turnout', 'right', ''))), \
            'Detail': detail \
        })
    endfor
    return dataTableMarkdown(rows, {'fields': ['Type', 'Name', 'Station', 'Side', 'Detail']})
endfunction


# The structure type display names
roadieStructureNames = { \
    'retainingWall': 'Retaining wall', \
    'bridge': 'Bridge', \
    'culvert': 'Culvert', \
    'turnout': 'Turnout', \
    'existingRoad': 'Existing road' \
}


#
# Drawing utilities
#


# The drawing colors
roadieColors = { \
    'asphalt': [70, 72, 76], \
    'bridge': [120, 104, 88], \
    'concrete': [190, 190, 185], \
    'cut': [196, 120, 64], \
    'existing': [112, 110, 104], \
    'fill': [218, 184, 96], \
    'gravel': [150, 146, 136], \
    'native': [168, 140, 100], \
    'wall': [160, 160, 158] \
}


# Format a color array as a CSS rgb() color, with an optional brightness factor
function roadieRGB(color, brightness):
    factor = if(brightness != null, brightness, 1)
    # mathFloor(x + 0.5) is mathRound(x) for the clamped (non-negative) components, and much faster
    return 'rgb(' + \
        mathFloor(mathMax(0, mathMin(255, arrayGet(color, 0) * factor)) + 0.5) + ',' + \
        mathFloor(mathMax(0, mathMin(255, arrayGet(color, 1) * factor)) + 0.5) + ',' + \
        mathFloor(mathMax(0, mathMin(255, arrayGet(color, 2) * factor)) + 0.5) + ')'
endfunction


# The terrain colors at the lowest, middle, and highest elevations
roadieTerrainLow = [96, 148, 84]
roadieTerrainMid = [176, 178, 112]
roadieTerrainHigh = [178, 142, 104]


# Compute a terrain cell's fill color - the terrain color for a normalized elevation (0 to 1), blended between the low,
# middle, and high colors, with the roadieRGB(color, roadieBrightness(nx, ny, 1)) computation inlined (this is called
# for every terrain cell)
function roadieTerrainFill(fraction, nx, ny):
    if fraction < 0.5:
        t = mathMax(0, fraction) * 2
        a = roadieTerrainLow
        b = roadieTerrainMid
    else:
        t = mathMin(1, fraction) * 2 - 1
        a = roadieTerrainMid
        b = roadieTerrainHigh
    endif
    length = mathSqrt(nx * nx + ny * ny + 1)
    dot = (nx * arrayGet(roadieLight, 0) + ny * arrayGet(roadieLight, 1) + arrayGet(roadieLight, 2)) / length
    if 1 / length < 0.1:
        dot = mathAbs(dot)
    endif
    factor = 0.5 + 0.6 * mathMax(0, dot)
    a0 = arrayGet(a, 0)
    a1 = arrayGet(a, 1)
    a2 = arrayGet(a, 2)
    return 'rgb(' + \
        mathFloor(mathMax(0, mathMin(255, (a0 + (arrayGet(b, 0) - a0) * t) * factor)) + 0.5) + ',' + \
        mathFloor(mathMax(0, mathMin(255, (a1 + (arrayGet(b, 1) - a1) * t) * factor)) + 0.5) + ',' + \
        mathFloor(mathMax(0, mathMin(255, (a2 + (arrayGet(b, 2) - a2) * t) * factor)) + 0.5) + ')'
endfunction


# The light direction - from the northwest, 45 degrees above the horizon
roadieLight = [-0.5, 0.5, 0.7071]


# Compute the brightness of a surface normal vector
function roadieBrightness(nx, ny, nz):
    length = mathSqrt(nx * nx + ny * ny + nz * nz)
    if length == 0:
        return 1
    endif
    dot = (nx * arrayGet(roadieLight, 0) + ny * arrayGet(roadieLight, 1) + nz * arrayGet(roadieLight, 2)) / length
    if mathAbs(nz / length) < 0.1:
        dot = mathAbs(dot)
    elif nz < 0:
        dot = -dot
    endif
    return 0.5 + 0.6 * mathMax(0, dot)
endfunction


# Compute the brightness of a polygon of world points ([x, y, z] arrays)
function roadiePolygonBrightness(points):
    a = arrayGet(points, 0)
    b = arrayGet(points, 1)
    c = arrayGet(points, 2)
    d = arrayGet(points, arrayLength(points) - 1)
    ux = arrayGet(c, 0) - arrayGet(a, 0)
    uy = arrayGet(c, 1) - arrayGet(a, 1)
    uz = arrayGet(c, 2) - arrayGet(a, 2)
    vx = arrayGet(d, 0) - arrayGet(b, 0)
    vy = arrayGet(d, 1) - arrayGet(b, 1)
    vz = arrayGet(d, 2) - arrayGet(b, 2)
    return roadieBrightness(uy * vz - uz * vy, uz * vx - ux * vz, ux * vy - uy * vx)
endfunction


# Compute a "nice" step size (1, 2, or 5 times a power of ten) for a range and approximate count
function roadieNiceStep(range, count):
    rough = mathMax(range, 1e-9) / count
    power = 10 ** mathFloor(mathLog(rough, 10))
    for multiple in [1, 2, 5]:
        if multiple * power >= rough:
            return multiple * power
        endif
    endfor
    return 10 * power
endfunction


# Get the topography's contour interval
function roadieContourInterval(plan, topo):
    interval = objectGet(objectGet(plan, 'topography'), 'contourInterval')
    return if(interval != null, interval, roadieNiceStep(objectGet(topo, 'maxZ') - objectGet(topo, 'minZ'), 25))
endfunction


# Compute a grid cell's contour segments at a level. The cell's corner elevations are given clockwise
# from the northwest corner. Returns an array of [fx1, fy1, fx2, fy2] segments in cell fractions, where
# fx increases to the east and fy increases to the south.
function roadieCellContours(zNW, zNE, zSE, zSW, level):
    # The edge crossings, clockwise from the north edge, as a flat [fx, fy, ...] array (this is called for
    # every cell and contour level, so the edges are unrolled)
    crossings = []
    if (zNW >= level) != (zNE >= level):
        arrayPush(crossings, (level - zNW) / (zNE - zNW), 0)
    endif
    if (zNE >= level) != (zSE >= level):
        arrayPush(crossings, 1, (level - zNE) / (zSE - zNE))
    endif
    if (zSE >= level) != (zSW >= level):
        arrayPush(crossings, 1 - (level - zSE) / (zSW - zSE), 1)
    endif
    if (zSW >= level) != (zNW >= level):
        arrayPush(crossings, 0, 1 - (level - zSW) / (zNW - zSW))
    endif

    # Pair the crossings into segments
    count = arrayLength(crossings)
    if count == 4:
        return [crossings]
    elif count == 8:
        return [arraySlice(crossings, 0, 4), arraySlice(crossings, 4, 8)]
    endif
    return []
endfunction


# Format a pixel coordinate
function roadiePx(value):
    return numberToFixed(value, 1, true)
endfunction


# Format a flat array of pixel coordinates as an SVG "points" attribute value
function roadieSvgPoints(coords):
    pointStrs = []
    ixCoord = 0
    while ixCoord < arrayLength(coords):
        arrayPush(pointStrs, numberToFixed(arrayGet(coords, ixCoord), 1, true) + ',' + numberToFixed(arrayGet(coords, ixCoord + 1), 1, true))
        ixCoord = ixCoord + 2
    endwhile
    return arrayJoin(pointStrs, ' ')
endfunction


# Create an SVG polygon element model from a flat array of pixel coordinates
function roadieSvgPolygon(coords, fill, stroke, strokeWidth, title):
    element = { \
        'svg': 'polygon', \
        'attr': {'points': roadieSvgPoints(coords), 'fill': fill, 'stroke': stroke, 'stroke-width': strokeWidth} \
    }
    if title != null:
        objectSet(element, 'elem', {'svg': 'title', 'elem': {'text': title}})
    endif
    return element
endfunction


# Create an SVG polyline element model from a flat array of pixel coordinates
function roadieSvgPolyline(coords, stroke, strokeWidth, dashArray):
    attr = {'points': roadieSvgPoints(coords), 'fill': 'none', 'stroke': stroke, 'stroke-width': strokeWidth, \
        'stroke-linejoin': 'round', 'stroke-linecap': 'round'}
    if dashArray != null:
        objectSet(attr, 'stroke-dasharray', dashArray)
    endif
    return {'svg': 'polyline', 'attr': attr}
endfunction


# Create an SVG text element model
function roadieSvgText(text, x, y, size, anchor, fill, bold):
    attr = { \
        'x': roadiePx(x), \
        'y': roadiePx(y), \
        'font-size': size, \
        'font-family': 'sans-serif', \
        'text-anchor': anchor, \
        'dominant-baseline': 'middle', \
        'fill': fill, \
        'stroke': 'white', \
        'stroke-width': 3, \
        'paint-order': 'stroke' \
    }
    if bold:
        objectSet(attr, 'font-weight', 'bold')
    endif
    return {'svg': 'text', 'attr': attr, 'elem': {'text': text}}
endfunction


# Compute a centered label's x coordinate that keeps it within a drawing's width - the label's width is estimated from its
# length and font size
function roadieLabelX(label, fontSize, x, width):
    halfLabel = stringLength(label) * fontSize * 0.32
    return mathMax(halfLabel + 4, mathMin(width - halfLabel - 4, x))
endfunction


# Create an SVG drawing element model
function roadieSvg(width, height, label, elements):
    return { \
        'svg': 'svg', \
        'attr': { \
            'width': width, \
            'height': height, \
            'viewBox': '0 0 ' + width + ' ' + height, \
            'role': 'img', \
            'aria-label': label, \
            'style': 'background: #f4f1ea; border: 1px solid #ccc; display: block; max-width: 100%; height: auto; ' + \
                'break-inside: avoid; margin: 0.75em 0 1.5em 0;' \
        }, \
        'elem': elements \
    }
endfunction


# Get a road sample's points: [left daylight, left edge, right edge, right daylight] as [x, y, z] arrays,
# plus the left and right wall bottom points (null if no wall)
function roadieSamplePoints(sample, halfWidth):
    x = objectGet(sample, 'x')
    y = objectGet(sample, 'y')
    z = objectGet(sample, 'z')
    nx = -objectGet(sample, 'dy')
    ny = objectGet(sample, 'dx')
    left = objectGet(sample, 'left')
    right = objectGet(sample, 'right')
    offsetLeft = halfWidth + objectGet(left, 'offset')
    offsetRight = halfWidth + objectGet(right, 'offset')
    return [ \
        [x + nx * offsetLeft, y + ny * offsetLeft, z + objectGet(left, 'drop')], \
        [x + nx * halfWidth, y + ny * halfWidth, z], \
        [x - nx * halfWidth, y - ny * halfWidth, z], \
        [x - nx * offsetRight, y - ny * offsetRight, z + objectGet(right, 'drop')] \
    ]
endfunction


#
# 3D view
#


# The maximum number of 3D terrain cells per side of a view
roadieMax3DCells = 240


# The minimum terrain cell size, in pixels, for drawing the minor contours in a 3D view
roadieMinorContourPx = 6


# The maximum number of interpolated grid points of a smooth 3D view's terrain
roadieMaxSmoothPoints = 40000


# The smooth 3D terrain's maximum cell size, in pixels, and the maximum number of cells per elevation grid cell side
roadieSmoothCellPx = 12
roadieMaxSmooth = 4


# The minimum drawn road width, in pixels - narrower roads are also drawn as a highlighted centerline
roadieMinRoadPx = 4


# The selected road option's highlighted centerline color
roadieRoadColor = '#d6246e'


# Compute the finished grade topography rows - the original grid with the road and its slopes applied
function roadieFinishedRows(topo, samples, halfWidth):
    rows = jsonParse(jsonStringify(objectGet(topo, 'rows')))
    spacing = objectGet(topo, 'spacing')
    nRows = objectGet(topo, 'nRows')
    nCols = objectGet(topo, 'nCols')
    interval = objectGet(arrayGet(samples, 1), 'station') - objectGet(arrayGet(samples, 0), 'station')
    for sample in samples:
        if objectGet(sample, 'bridge') || objectGet(sample, 'outside'):
            continue
        endif
        x = objectGet(sample, 'x')
        y = objectGet(sample, 'y')
        z = objectGet(sample, 'z')
        dx = objectGet(sample, 'dx')
        dy = objectGet(sample, 'dy')
        left = objectGet(sample, 'left')
        right = objectGet(sample, 'right')
        extentLeft = halfWidth + objectGet(left, 'offset')
        extentRight = halfWidth + objectGet(right, 'offset')
        radius = mathMax(extentLeft, extentRight) + interval
        colMin = mathMax(0, mathCeil((x - radius) / spacing))
        colMax = mathMin(nCols - 1, mathFloor((x + radius) / spacing))
        rowMin = mathMax(0, mathCeil((nRows - 1) - (y + radius) / spacing))
        rowMax = mathMin(nRows - 1, mathFloor((nRows - 1) - (y - radius) / spacing))
        row = rowMin
        while row <= rowMax:
            gy = (nRows - 1 - row) * spacing
            col = colMin
            while col <= colMax:
                gx = col * spacing
                along = (gx - x) * dx + (gy - y) * dy
                offset = (gx - x) * -dy + (gy - y) * dx
                if mathAbs(along) <= interval * 0.5 && offset <= extentLeft && offset >= -extentRight:
                    if mathAbs(offset) <= halfWidth:
                        arraySet(arrayGet(rows, row), col, z)
                    else:
                        side = if(offset > 0, left, right)
                        fraction = (mathAbs(offset) - halfWidth) / objectGet(side, 'offset')
                        arraySet(arrayGet(rows, row), col, z + objectGet(side, 'drop') * fraction)
                    endif
                endif
                col = col + 1
            endwhile
            row = row + 1
        endwhile
    endfor
    return rows
endfunction


# The 3D view's padding around the topography, in pixels (room for the start and end labels)
roadie3DPad = 16


# Compute the height of the 3D view's start and end marker poles (unexaggerated)
function roadie3DPoleHeight(topo, exaggeration):
    return (objectGet(topo, 'maxZ') - objectGet(topo, 'minZ')) * 0.15 / exaggeration + objectGet(topo, 'spacing')
endfunction


# Create a 3D view projection object from the view arguments ("azimuth", "tilt", "exaggeration", and the optional
# "zoom", "x", "y", "z", "smooth", and "fill"). The view's height is the maximum height for a fill view, the topography's height
# at the fit scale for an unzoomed view of the whole site, and otherwise the maximum height trimmed to the landscape.
function roadieProjection(topo, args, width, maxHeight):
    azimuth = objectGet(args, 'azimuth') * mathPi() / 180
    tilt = mathMax(5, mathMin(90, objectGet(args, 'tilt'))) * mathPi() / 180
    exaggeration = objectGet(args, 'exaggeration')
    view = { \
        'cosAz': mathCos(azimuth), \
        'sinAz': mathSin(azimuth), \
        'cosTilt': mathCos(tilt), \
        'sinTilt': mathSin(tilt), \
        'exaggeration': exaggeration, \
        'width': width \
    }

    # Fit the topography's bounding box as viewed from 30 degrees off its axes, with the marker poles above it.
    # The scale doesn't change as the view rotates - views near the diagonals clip the topography's corners
    # slightly.
    topoWidth = objectGet(topo, 'width')
    topoHeight = objectGet(topo, 'height')
    poleHeight = roadie3DPoleHeight(topo, exaggeration)
    halfZ = (objectGet(topo, 'maxZ') - objectGet(topo, 'minZ')) * 0.5 * exaggeration
    cos30 = mathSqrt(3) * 0.5
    halfXY = mathMax(topoWidth * cos30 + topoHeight * 0.5, topoWidth * 0.5 + topoHeight * cos30) * 0.5
    vSpan = 2 * halfXY * objectGet(view, 'sinTilt') + (2 * halfZ + poleHeight * exaggeration) * objectGet(view, 'cosTilt')
    scale = mathMin((width - 2 * roadie3DPad) / mathMax(2 * halfXY, 1e-9), (maxHeight - 2 * roadie3DPad) / mathMax(vSpan, 1e-9))
    zoom = mathMax(1, mathMin(roadieMaxZoom, objectGet(args, 'zoom', 1)))
    objectSet(view, 'zoom', zoom)
    objectSet(view, 'smooth', if(objectGet(args, 'smooth'), true, false))
    objectSet(view, 'scale', scale * zoom)

    # The view center point - the default is the topography's center, raised half the marker pole height to fit the
    # poles. A view center x, y without z is on the ground.
    centerX = objectGet(args, 'x')
    centerY = objectGet(args, 'y')
    xc = mathMax(0, mathMin(topoWidth, if(centerX != null, centerX, topoWidth * 0.5)))
    yc = mathMax(0, mathMin(topoHeight, if(centerY != null, centerY, topoHeight * 0.5)))
    centerZ = objectGet(args, 'z')
    zc = if(centerZ != null, centerZ, if(centerX != null || centerY != null, roadieElevation(topo, xc, yc), \
        (objectGet(topo, 'minZ') + objectGet(topo, 'maxZ')) * 0.5 + poleHeight * 0.5))
    objectSet(view, 'xc', xc)
    objectSet(view, 'yc', yc)
    objectSet(view, 'zc', zc)
    objectSet(view, 'fullHeight', maxHeight)

    # A fill view (the 3D explorer) is the maximum height, with the view center at its middle
    if objectGet(args, 'fill'):
        objectSet(view, 'height', maxHeight)
        objectSet(view, 'cy', maxHeight * 0.5)
        return view
    endif

    # The fit view's height fits the topography, with the view center at the view's middle
    if zoom == 1 && centerX == null && centerY == null && centerZ == null:
        height = mathMin(maxHeight, mathCeil(vSpan * scale + 2 * roadie3DPad))
        objectSet(view, 'height', height)
        objectSet(view, 'cy', height * 0.5)
        return view
    endif

    # A zoomed or moved view is the maximum height with the view center at its middle, less the empty bands above and
    # below the landscape (the marker poles above the landscape and padding are kept)
    upRange = roadieViewUpRange(view, topo)
    viewScale = objectGet(view, 'scale')
    poleMargin = poleHeight / zoom * exaggeration * objectGet(view, 'cosTilt') * viewScale + 24
    top = mathMax(0, maxHeight * 0.5 - arrayGet(upRange, 1) * viewScale - poleMargin)
    bottom = mathMin(maxHeight, maxHeight * 0.5 - arrayGet(upRange, 0) * viewScale + roadie3DPad)
    if bottom - top < 1:
        # The landscape is out of view
        top = 0
        bottom = maxHeight
    endif
    objectSet(view, 'height', mathCeil(bottom - top))
    objectSet(view, 'cy', maxHeight * 0.5 - top)
    return view
endfunction


# The maximum number of topography grid points per side sampled for the 3D view's vertical extent
roadieMaxExtentPoints = 160


# Compute a view's vertical extent of the topography - [lowest, highest] "up" coordinate (unscaled view units,
# relative to the view center) of the topography's grid points
function roadieViewUpRange(view, topo):
    rows = objectGet(topo, 'rows')
    nRows = objectGet(topo, 'nRows')
    nCols = objectGet(topo, 'nCols')
    spacing = objectGet(topo, 'spacing')
    step = mathMax(1, mathCeil(mathMax(nRows, nCols) / roadieMaxExtentPoints))
    xc = objectGet(view, 'xc')
    yc = objectGet(view, 'yc')
    zc = objectGet(view, 'zc')
    vx = objectGet(view, 'sinAz') * objectGet(view, 'sinTilt')
    vy = objectGet(view, 'cosAz') * objectGet(view, 'sinTilt')
    vz = objectGet(view, 'exaggeration') * objectGet(view, 'cosTilt')
    upMin = null
    upMax = null
    row = 0
    while row < nRows:
        rowZ = arrayGet(rows, row)
        upY = ((nRows - 1 - row) * spacing - yc) * vy
        col = 0
        while col < nCols:
            up = (col * spacing - xc) * vx + upY + (arrayGet(rowZ, col) - zc) * vz
            upMin = if(upMin == null, up, mathMin(upMin, up))
            upMax = if(upMax == null, up, mathMax(upMax, up))
            col = if(col == nCols - 1, nCols, mathMin(nCols - 1, col + step))
        endwhile
        row = if(row == nRows - 1, nRows, mathMin(nRows - 1, row + step))
    endwhile
    return [upMin, upMax]
endfunction


# Find the point ([x, y]) at an elevation under a view pixel - the inverse of roadieProject
function roadieUnprojectZ(view, px, py, z):
    cosAz = objectGet(view, 'cosAz')
    sinAz = objectGet(view, 'sinAz')
    scale = objectGet(view, 'scale')
    u = (px - objectGet(view, 'width') * 0.5) / scale
    up = (objectGet(view, 'cy') - py) / scale
    v = (up - (z - objectGet(view, 'zc')) * objectGet(view, 'exaggeration') * objectGet(view, 'cosTilt')) / \
        objectGet(view, 'sinTilt')
    return [objectGet(view, 'xc') + u * cosAz + v * sinAz, objectGet(view, 'yc') - u * sinAz + v * cosAz]
endfunction


# Find the ground point ([x, y], within the topography) under a view pixel
function roadieUnproject(view, topo, px, py):
    # The pixel's view ray is intersected with the ground iteratively - start at the view center elevation
    z = objectGet(view, 'zc')
    ixIteration = 0
    while ixIteration < 8:
        point = roadieUnprojectZ(view, px, py, z)
        x = mathMax(0, mathMin(objectGet(topo, 'width'), arrayGet(point, 0)))
        y = mathMax(0, mathMin(objectGet(topo, 'height'), arrayGet(point, 1)))
        z = roadieElevation(topo, x, y)
        ixIteration = ixIteration + 1
    endwhile
    return [x, y]
endfunction


# Project a world point to the view - returns [px, py, depth] (larger depth is farther away)
function roadieProject(view, x, y, z):
    x0 = x - objectGet(view, 'xc')
    y0 = y - objectGet(view, 'yc')
    z0 = (z - objectGet(view, 'zc')) * objectGet(view, 'exaggeration')
    cosAz = objectGet(view, 'cosAz')
    sinAz = objectGet(view, 'sinAz')
    u = x0 * cosAz - y0 * sinAz
    v = x0 * sinAz + y0 * cosAz
    up = v * objectGet(view, 'sinTilt') + z0 * objectGet(view, 'cosTilt')
    depth = v * objectGet(view, 'cosTilt') - z0 * objectGet(view, 'sinTilt')
    scale = objectGet(view, 'scale')
    return [ \
        objectGet(view, 'width') * 0.5 + u * scale, \
        objectGet(view, 'cy') - up * scale, \
        depth \
    ]
endfunction


# Project a ground point to the view - returns [px, py, depth], or null if the point is outside the topography
function roadieProjectGround(view, topo, x, y):
    z = roadieElevation(topo, x, y)
    return if(z != null, roadieProject(view, x, y, z))
endfunction


# Project world points ([x, y, z] arrays) to a flat pixel coordinate array and the average depth
function roadieProjectPoints(view, points):
    # The roadieProject computation, inlined with the view values hoisted out of the point loop (this is
    # called for every 3D polygon)
    xc = objectGet(view, 'xc')
    yc = objectGet(view, 'yc')
    zc = objectGet(view, 'zc')
    exaggeration = objectGet(view, 'exaggeration')
    cosAz = objectGet(view, 'cosAz')
    sinAz = objectGet(view, 'sinAz')
    cosTilt = objectGet(view, 'cosTilt')
    sinTilt = objectGet(view, 'sinTilt')
    scale = objectGet(view, 'scale')
    halfWidth = objectGet(view, 'width') * 0.5
    cy = objectGet(view, 'cy')
    coords = []
    depth = 0
    for point in points:
        x0 = arrayGet(point, 0) - xc
        y0 = arrayGet(point, 1) - yc
        z0 = (arrayGet(point, 2) - zc) * exaggeration
        v = x0 * sinAz + y0 * cosAz
        arrayPush(coords, \
            halfWidth + (x0 * cosAz - y0 * sinAz) * scale, \
            cy - (v * sinTilt + z0 * cosTilt) * scale \
        )
        depth = depth + (v * cosTilt - z0 * sinTilt)
    endfor
    return [coords, depth / arrayLength(points)]
endfunction


# Sort 3D items ([depth, element]) by depth, farthest first, keeping the order of equal depths - the same order as a
# stable sort with roadieCompareDepth. The items are bucketed by depth (a bucket's items are all at least as far as the
# next bucket's), and only each bucket is sorted, which takes far fewer comparisons.
function roadieSortDepth(items):
    count = arrayLength(items)
    if count < 2:
        return items
    endif
    minDepth = arrayGet(arrayGet(items, 0), 0)
    maxDepth = minDepth
    for item in items:
        minDepth = mathMin(minDepth, arrayGet(item, 0))
        maxDepth = mathMax(maxDepth, arrayGet(item, 0))
    endfor
    bucketCount = mathMax(1, mathFloor(count / 4))
    bucketScale = (bucketCount - 1) / mathMax(maxDepth - minDepth, 1e-12)
    buckets = arrayNewSize(bucketCount, null)
    for item in items:
        ixBucket = mathMin(bucketCount - 1, mathFloor((maxDepth - arrayGet(item, 0)) * bucketScale))
        bucket = arrayGet(buckets, ixBucket)
        if bucket == null:
            arraySet(buckets, ixBucket, [item])
        else:
            arrayPush(bucket, item)
        endif
    endfor
    sorted = []
    for bucket in buckets:
        if bucket != null:
            if arrayLength(bucket) > 1:
                arraySort(bucket, roadieCompareDepth)
            endif
            arrayExtend(sorted, bucket)
        endif
    endfor
    return sorted
endfunction


# Compare two depth-sorted 3D items (farthest first)
function roadieCompareDepth(a, b):
    return arrayGet(b, 0) - arrayGet(a, 0)
endfunction


# Project a terrain grid row's points at the given columns - the grid's northwest point is at (xOrigin, yTop). Returns
# an array of the formatted "x,y" pixel point strings, an array of the depths, and an array of the points' view
# outcodes - 1 left of the view, 2 right of it, plus 4 above it, 8 below it. The projection is the roadieProjectPoints
# computation.
function roadieProjectGridRow(view, rows, row, cols, xOrigin, yTop, spacing):
    xc = objectGet(view, 'xc')
    yc = objectGet(view, 'yc')
    zc = objectGet(view, 'zc')
    exaggeration = objectGet(view, 'exaggeration')
    cosAz = objectGet(view, 'cosAz')
    sinAz = objectGet(view, 'sinAz')
    cosTilt = objectGet(view, 'cosTilt')
    sinTilt = objectGet(view, 'sinTilt')
    scale = objectGet(view, 'scale')
    width = objectGet(view, 'width')
    height = objectGet(view, 'height')
    halfWidth = width * 0.5
    cy = objectGet(view, 'cy')
    rowZ = arrayGet(rows, row)
    y0 = yTop - row * spacing - yc
    points = []
    depths = []
    codes = []
    for col in cols:
        x0 = xOrigin + col * spacing - xc
        z0 = (arrayGet(rowZ, col) - zc) * exaggeration
        v = x0 * sinAz + y0 * cosAz
        px = halfWidth + (x0 * cosAz - y0 * sinAz) * scale
        py = cy - (v * sinTilt + z0 * cosTilt) * scale
        arrayPush(points, numberToFixed(px, 1, true) + ',' + numberToFixed(py, 1, true))
        arrayPush(depths, v * cosTilt - z0 * sinTilt)
        arrayPush(codes, if(px < 0, 1, if(px > width, 2, 0)) + if(py < 0, 4, if(py > height, 8, 0)))
    endfor
    return [points, depths, codes]
endfunction


# Determine if any of a flat array of pixel coordinates' bounding box is within a view
function roadieCoordsVisible(view, coords):
    xMin = arrayGet(coords, 0)
    xMax = xMin
    yMin = arrayGet(coords, 1)
    yMax = yMin
    ixCoord = 2
    while ixCoord < arrayLength(coords):
        xMin = mathMin(xMin, arrayGet(coords, ixCoord))
        xMax = mathMax(xMax, arrayGet(coords, ixCoord))
        yMin = mathMin(yMin, arrayGet(coords, ixCoord + 1))
        yMax = mathMax(yMax, arrayGet(coords, ixCoord + 1))
        ixCoord = ixCoord + 2
    endwhile
    return xMax >= 0 && xMin <= objectGet(view, 'width') && yMax >= 0 && yMin <= objectGet(view, 'height')
endfunction


# Add a 3D item to an items array, unless it's null (not visible)
function roadiePushItem(items, item):
    if item != null:
        arrayPush(items, item)
    endif
endfunction


# Create a 3D shaded polygon item ([depth, element]) from world points - null if it's outside the view
function roadie3DPolygon(view, points, color, bias, title):
    projected = roadieProjectPoints(view, points)
    if !roadieCoordsVisible(view, arrayGet(projected, 0)):
        return null
    endif
    exaggeration = objectGet(view, 'exaggeration')
    worldPoints = []
    for point in points:
        arrayPush(worldPoints, [arrayGet(point, 0), arrayGet(point, 1), arrayGet(point, 2) * exaggeration])
    endfor
    fill = roadieRGB(color, roadiePolygonBrightness(worldPoints))
    return [arrayGet(projected, 1) - bias, roadieSvgPolygon(arrayGet(projected, 0), fill, fill, 0.5, title)]
endfunction


# Interpolate a Catmull-Rom spline through four values at a fraction (0 to 1) between the middle two
function roadieCubic(z0, z1, z2, z3, t):
    return z1 + 0.5 * t * (z2 - z0 + t * (2 * z0 - 5 * z1 + 4 * z2 - z3 + t * (3 * (z1 - z2) + z3 - z0)))
endfunction


# Divide an elevation grid's cells (within the given rows and columns) into smaller cells - "count" cells per grid cell
# side. The elevations are interpolated with Catmull-Rom splines, clamped to the elevation range of each grid cell's
# corners so the smooth surface never bulges past the grid (or over the road). Returns the smaller cells' grid rows,
# from the first grid row and column.
function roadieSmoothRows(rows, rowFirst, rowLast, colFirst, colLast, count):
    nRows = arrayLength(rows)
    nCols = arrayLength(arrayGet(rows, 0))
    fineCols = (colLast - colFirst) * count

    # Interpolate the grid rows along their columns - including a grid row on either side, for the splines
    colRows = []
    row = rowFirst - 1
    while row <= rowLast + 1:
        rowZ = arrayGet(rows, mathMax(0, mathMin(nRows - 1, row)))
        values = []
        fineCol = 0
        while fineCol <= fineCols:
            col = colFirst + mathFloor(fineCol / count)
            t = (fineCol % count) / count
            arrayPush(values, if(t == 0, arrayGet(rowZ, col), roadieCubic( \
                arrayGet(rowZ, mathMax(0, col - 1)), arrayGet(rowZ, col), arrayGet(rowZ, col + 1), \
                arrayGet(rowZ, mathMin(nCols - 1, col + 2)), t)))
            fineCol = fineCol + 1
        endwhile
        arrayPush(colRows, values)
        row = row + 1
    endwhile

    # Interpolate between the column-interpolated rows, clamped to each grid cell's corner elevations
    fineRows = []
    fineRow = 0
    while fineRow <= (rowLast - rowFirst) * count:
        row = rowFirst + mathFloor(fineRow / count)
        t = (fineRow % count) / count
        ixRow = row - rowFirst + 1
        rowTop = arrayGet(rows, row)
        rowBottom = arrayGet(rows, mathMin(nRows - 1, row + 1))
        values = []
        fineCol = 0
        while fineCol <= fineCols:
            if t == 0:
                z = arrayGet(arrayGet(colRows, ixRow), fineCol)
            else:
                z = roadieCubic(arrayGet(arrayGet(colRows, ixRow - 1), fineCol), arrayGet(arrayGet(colRows, ixRow), fineCol), \
                    arrayGet(arrayGet(colRows, ixRow + 1), fineCol), arrayGet(arrayGet(colRows, ixRow + 2), fineCol), t)
            endif
            col = colFirst + mathFloor(fineCol / count)
            col2 = mathMin(nCols - 1, col + 1)
            zNW = arrayGet(rowTop, col)
            zNE = arrayGet(rowTop, col2)
            zSW = arrayGet(rowBottom, col)
            zSE = arrayGet(rowBottom, col2)
            arrayPush(values, mathMax(mathMin(zNW, zNE, zSW, zSE), mathMin(mathMax(zNW, zNE, zSW, zSE), z)))
            fineCol = fineCol + 1
        endwhile
        arrayPush(fineRows, values)
        fineRow = fineRow + 1
    endwhile
    return fineRows
endfunction


# Find the grid rows and columns of a view's visible terrain cells - [rowFirst, rowLast, colFirst, colLast], the bounds of
# the cells (within the given grid rows and columns) that aren't culled because all of their corners are outside the same
# side of the view, extended by a cell on each side - or null if no cell is visible. The cull box (roadieViewCullBox)
# spans the topography's whole elevation range, so on steep sites it's much larger than the visible terrain.
function roadieVisibleCells(view, topo, rows, rowFirst, rowLast, colFirst, colLast):
    nRows = objectGet(topo, 'nRows')
    spacing = objectGet(topo, 'spacing')
    xc = objectGet(view, 'xc')
    yc = objectGet(view, 'yc')
    zc = objectGet(view, 'zc')
    exaggeration = objectGet(view, 'exaggeration')
    cosAz = objectGet(view, 'cosAz')
    sinAz = objectGet(view, 'sinAz')
    cosTilt = objectGet(view, 'cosTilt')
    sinTilt = objectGet(view, 'sinTilt')
    scale = objectGet(view, 'scale')
    width = objectGet(view, 'width')
    height = objectGet(view, 'height')
    halfWidth = width * 0.5
    cy = objectGet(view, 'cy')
    visible = null
    codesPrev = null
    row = rowFirst
    while row <= rowLast:
        # The row's points' view outcodes (roadieProjectGridRow)
        rowZ = arrayGet(rows, row)
        y0 = (nRows - 1 - row) * spacing - yc
        codes = []
        col = colFirst
        while col <= colLast:
            x0 = col * spacing - xc
            px = halfWidth + (x0 * cosAz - y0 * sinAz) * scale
            py = cy - ((x0 * sinAz + y0 * cosAz) * sinTilt + (arrayGet(rowZ, col) - zc) * exaggeration * cosTilt) * scale
            arrayPush(codes, if(px < 0, 1, if(px > width, 2, 0)) + if(py < 0, 4, if(py > height, 8, 0)))
            col = col + 1
        endwhile

        # The visible cells between the previous row and this row
        if codesPrev != null:
            ixCol = 0
            while ixCol < arrayLength(codes) - 1:
                if !(arrayGet(codesPrev, ixCol) & arrayGet(codesPrev, ixCol + 1) & arrayGet(codes, ixCol + 1) & arrayGet(codes, ixCol)):
                    cellCol = colFirst + ixCol
                    visible = if(visible == null, [row - 1, row, cellCol, cellCol + 1], [ \
                        arrayGet(visible, 0), row, mathMin(arrayGet(visible, 2), cellCol), mathMax(arrayGet(visible, 3), cellCol + 1) \
                    ])
                endif
                ixCol = ixCol + 1
            endwhile
        endif
        codesPrev = codes
        row = row + 1
    endwhile
    if visible == null:
        return null
    endif
    return [ \
        mathMax(rowFirst, arrayGet(visible, 0) - 1), mathMin(rowLast, arrayGet(visible, 1) + 1), \
        mathMax(colFirst, arrayGet(visible, 2) - 1), mathMin(colLast, arrayGet(visible, 3) + 1) \
    ]
endfunction


# Compute a zoomed view's cull box - [xMin, xMax, yMin, yMax], the bounds of the view's corners on the ground between
# the lowest and highest elevations of the topography and the road samples (their grade and ground - with no samples,
# the topography's alone). A point within those elevations can only be visible within the box.
function roadieViewCullBox(view, topo, samples):
    zLow = objectGet(topo, 'minZ')
    zHigh = objectGet(topo, 'maxZ')
    for sample in samples:
        zLow = mathMin(zLow, objectGet(sample, 'z'), objectGet(sample, 'ground'))
        zHigh = mathMax(zHigh, objectGet(sample, 'z'), objectGet(sample, 'ground'))
    endfor
    width = objectGet(view, 'width')
    height = objectGet(view, 'height')
    box = null
    for corner in [[0, 0], [width, 0], [width, height], [0, height]]:
        for cornerZ in [zLow, zHigh]:
            point = roadieUnprojectZ(view, arrayGet(corner, 0), arrayGet(corner, 1), cornerZ)
            x = arrayGet(point, 0)
            y = arrayGet(point, 1)
            box = if(box == null, [x, x, y, y], \
                [mathMin(arrayGet(box, 0), x), mathMax(arrayGet(box, 1), x), mathMin(arrayGet(box, 2), y), mathMax(arrayGet(box, 3), y)])
        endfor
    endfor
    return box
endfunction


# Create a 3D view SVG element model of a projection (roadieProjection) - "rows" are the finished grade topography
# rows (roadieFinishedRows)
function roadieView3D(plan, topo, rows, ixOption, analysis, view):
    units = objectGet(plan, 'units')
    samples = objectGet(analysis, 'samples')
    option = arrayGet(objectGet(plan, 'options'), ixOption)
    section = objectGet(option, 'section')
    halfWidth = objectGet(section, 'width') * 0.5
    spacing = objectGet(topo, 'spacing')
    width = objectGet(view, 'width')
    viewHeight = objectGet(view, 'height')
    exaggeration = objectGet(view, 'exaggeration')
    items = []

    # The view values for the inlined roadieProject computation of the cell contours
    xc = objectGet(view, 'xc')
    yc = objectGet(view, 'yc')
    zc = objectGet(view, 'zc')
    cosAz = objectGet(view, 'cosAz')
    sinAz = objectGet(view, 'sinAz')
    cosTilt = objectGet(view, 'cosTilt')
    sinTilt = objectGet(view, 'sinTilt')
    cy = objectGet(view, 'cy')
    viewHalfWidth = width * 0.5

    # Terrain cells
    nRows = objectGet(topo, 'nRows')
    nCols = objectGet(topo, 'nCols')
    scale = objectGet(view, 'scale')

    # The visible grid rows and columns - a zoomed view draws only the visible cells, in finer detail. Every visible
    # ground point is on a corner pixel's view ray between the lowest and highest elevations, so the visible area
    # is within the bounds of those eight points.
    rowFirst = 0
    rowLast = nRows - 1
    colFirst = 0
    colLast = nCols - 1
    cullBox = null
    if objectGet(view, 'zoom') > 1:
        gridBox = roadieViewCullBox(view, topo, [])
        colFirst = mathMax(0, mathMin(nCols - 2, mathFloor(arrayGet(gridBox, 0) / spacing)))
        colLast = mathMin(nCols - 1, mathMax(colFirst + 1, mathCeil(arrayGet(gridBox, 1) / spacing)))
        rowFirst = mathMax(0, mathMin(nRows - 2, mathFloor((nRows - 1) - arrayGet(gridBox, 3) / spacing)))
        rowLast = mathMin(nRows - 1, mathMax(rowFirst + 1, mathCeil((nRows - 1) - arrayGet(gridBox, 2) / spacing)))
        cullBox = roadieViewCullBox(view, topo, samples)
    endif
    step = mathMax(1, mathCeil(mathMax(rowLast - rowFirst, colLast - colFirst) / roadieMax3DCells))
    cellSize = step * spacing
    minZ = objectGet(topo, 'minZ')
    rangeZ = mathMax(objectGet(topo, 'maxZ') - minZ, 1e-9)
    contourInterval = roadieContourInterval(plan, topo)
    contourColor = 'rgba(70,50,30,0.45)'

    # The terrain grid - the elevation grid, or for a smooth view drawing every elevation grid cell, the visible grid
    # cells divided into smaller cells interpolated between the grid points
    drawRows = rows
    drawSpacing = spacing
    xOrigin = 0
    yTop = (nRows - 1) * spacing
    smooth = 1
    visible = if(objectGet(view, 'smooth') && step == 1, roadieVisibleCells(view, topo, rows, rowFirst, rowLast, colFirst, colLast))
    if visible != null:
        # The smooth view divides only the visible grid cells, so its point budget is spent on the drawn terrain
        visiblePoints = (arrayGet(visible, 1) - arrayGet(visible, 0) + 1) * (arrayGet(visible, 3) - arrayGet(visible, 2) + 1)
        smooth = mathMin(roadieMaxSmooth, mathCeil(spacing * scale / roadieSmoothCellPx), \
            mathFloor(mathSqrt(roadieMaxSmoothPoints / visiblePoints)))
    endif
    if smooth > 1:
        rowFirst = arrayGet(visible, 0)
        rowLast = arrayGet(visible, 1)
        colFirst = arrayGet(visible, 2)
        colLast = arrayGet(visible, 3)
        drawRows = roadieSmoothRows(rows, rowFirst, rowLast, colFirst, colLast, smooth)
        drawSpacing = spacing / smooth
        xOrigin = colFirst * spacing
        yTop = (nRows - 1 - rowFirst) * spacing
        rowLast = (rowLast - rowFirst) * smooth
        colLast = (colLast - colFirst) * smooth
        rowFirst = 0
        colFirst = 0
    endif

    # The minor contours are drawn only where they're far enough apart to read - where a terrain cell is at least
    # roadieMinorContourPx pixels
    drawMinor = step * drawSpacing * scale >= roadieMinorContourPx

    # The grid columns of the cell corners
    cols = [colFirst]
    col = colFirst
    while col < colLast:
        col = mathMin(colLast, col + step)
        arrayPush(cols, col)
    endwhile

    # Each cell corner is shared by up to four cells, so the corners are projected one grid row at a time
    ixColLast = arrayLength(cols) - 2
    row = rowFirst
    projectedTop = roadieProjectGridRow(view, drawRows, row, cols, xOrigin, yTop, drawSpacing)
    while row < rowLast:
        row2 = mathMin(rowLast, row + step)
        y1 = yTop - row * drawSpacing
        y2 = yTop - row2 * drawSpacing
        cellHeight = y1 - y2
        zRow = arrayGet(drawRows, row)
        zRow2 = arrayGet(drawRows, row2)
        rowNorth = mathMax(rowFirst, row - step)
        rowSouth = mathMin(rowLast, row2 + step)
        zRowNorth = arrayGet(drawRows, rowNorth)
        zRowSouth = arrayGet(drawRows, rowSouth)
        dySpan = (rowSouth - rowNorth) * drawSpacing
        projectedBottom = roadieProjectGridRow(view, drawRows, row2, cols, xOrigin, yTop, drawSpacing)
        pointsTop = arrayGet(projectedTop, 0)
        depthsTop = arrayGet(projectedTop, 1)
        pointsBottom = arrayGet(projectedBottom, 0)
        depthsBottom = arrayGet(projectedBottom, 1)
        codesTop = arrayGet(projectedTop, 2)
        codesBottom = arrayGet(projectedBottom, 2)
        ixCol = -1
        while ixCol < ixColLast:
            ixCol = ixCol + 1

            # Skip the cell if its corners' bounding box is outside the view - if all of its corners are outside the same
            # side of the view
            if arrayGet(codesTop, ixCol) & arrayGet(codesTop, ixCol + 1) & arrayGet(codesBottom, ixCol + 1) & arrayGet(codesBottom, ixCol):
                continue
            endif
            col = arrayGet(cols, ixCol)
            col2 = arrayGet(cols, ixCol + 1)
            x1 = xOrigin + col * drawSpacing
            x2 = xOrigin + col2 * drawSpacing
            zNW = arrayGet(zRow, col)
            zNE = arrayGet(zRow, col2)
            zSE = arrayGet(zRow2, col2)
            zSW = arrayGet(zRow2, col)
            cellPoints = arrayGet(pointsTop, ixCol) + ' ' + arrayGet(pointsTop, ixCol + 1) + ' ' + \
                arrayGet(pointsBottom, ixCol + 1) + ' ' + arrayGet(pointsBottom, ixCol)
            cellDepth = (arrayGet(depthsTop, ixCol) + arrayGet(depthsTop, ixCol + 1) + \
                arrayGet(depthsBottom, ixCol + 1) + arrayGet(depthsBottom, ixCol)) / 4

            # Shade the cell by its elevation and slope - the slope spans the neighboring cells, too, so the shading
            # changes gradually from cell to cell
            cellWidth = x2 - x1
            colWest = mathMax(colFirst, col - step)
            colEast = mathMin(colLast, col2 + step)
            dzdx = ((arrayGet(zRow, colEast) + arrayGet(zRow2, colEast)) - (arrayGet(zRow, colWest) + arrayGet(zRow2, colWest))) * 0.5 / \
                ((colEast - colWest) * drawSpacing) * exaggeration
            dzdy = ((arrayGet(zRowNorth, col) + arrayGet(zRowNorth, col2)) - (arrayGet(zRowSouth, col) + arrayGet(zRowSouth, col2))) * 0.5 / \
                dySpan * exaggeration
            zAvg = (zNW + zNE + zSE + zSW) * 0.25
            fill = roadieTerrainFill((zAvg - minZ) / rangeZ, -dzdx, -dzdy)
            cellElements = [{'svg': 'polygon', 'attr': {'points': cellPoints, 'fill': fill, 'stroke': fill, 'stroke-width': 0.6}}]

            # Cell contours - a path of the minor contours and a path of the index contours
            minorPath = []
            indexPath = []
            level = mathCeil(mathMin(zNW, zNE, zSE, zSW) / contourInterval) * contourInterval
            zMax = mathMax(zNW, zNE, zSE, zSW)
            while level <= zMax:
                indexLevel = level / contourInterval / 5
                isIndex = mathAbs(indexLevel - mathFloor(indexLevel + 0.5)) < 1e-6
                if isIndex || drawMinor:
                    # The segments' end points are projected with the roadieProject computation, inlined - the level's
                    # elevation term is the same for every end point
                    zUp = (level - zc) * exaggeration * cosTilt
                    for segment in roadieCellContours(zNW, zNE, zSE, zSW, level):
                        x0 = x1 + arrayGet(segment, 0) * cellWidth - xc
                        y0 = y1 - arrayGet(segment, 1) * cellHeight - yc
                        sx1 = viewHalfWidth + (x0 * cosAz - y0 * sinAz) * scale
                        sy1 = cy - ((x0 * sinAz + y0 * cosAz) * sinTilt + zUp) * scale
                        x0 = x1 + arrayGet(segment, 2) * cellWidth - xc
                        y0 = y1 - arrayGet(segment, 3) * cellHeight - yc
                        sx2 = viewHalfWidth + (x0 * cosAz - y0 * sinAz) * scale
                        sy2 = cy - ((x0 * sinAz + y0 * cosAz) * sinTilt + zUp) * scale
                        arrayPush(if(isIndex, indexPath, minorPath), 'M' + numberToFixed(sx1, 1, true) + ' ' + \
                            numberToFixed(sy1, 1, true) + 'L' + numberToFixed(sx2, 1, true) + ' ' + numberToFixed(sy2, 1, true))
                    endfor
                endif
                level = level + contourInterval
            endwhile
            if minorPath:
                arrayPush(cellElements, {'svg': 'path', 'attr': {'d': arrayJoin(minorPath, ''), 'fill': 'none', \
                    'stroke': contourColor, 'stroke-width': 0.5, 'stroke-linecap': 'round'}})
            endif
            if indexPath:
                arrayPush(cellElements, {'svg': 'path', 'attr': {'d': arrayJoin(indexPath, ''), 'fill': 'none', \
                    'stroke': contourColor, 'stroke-width': 1.2, 'stroke-linecap': 'round'}})
            endif
            arrayPush(items, [cellDepth, cellElements])
        endwhile
        row = row2
        projectedTop = projectedBottom
    endwhile

    # Features
    for feature in objectGet(topo, 'features'):
        type = objectGet(feature, 'type')
        points = objectGet(feature, 'points')
        if type != 'stream':
            points = arrayCopy(points)
            arrayPush(points, arrayGet(points, 0))
        endif
        stroke = if(type == 'stream', '#2a6fdb', if(type == 'rock', '#555555', 'rgba(208,49,45,0.55)'))
        for point, ixPoint in points:
            if ixPoint > 0:
                prev = arrayGet(points, ixPoint - 1)
                x1 = objectGet(prev, 'x')
                y1 = objectGet(prev, 'y')
                x2 = objectGet(point, 'x')
                y2 = objectGet(point, 'y')

                # Skip the segment if it's outside the view's ground area - with a margin, so its steps are, too
                if cullBox != null && roadieOutsideBox(cullBox, mathMin(x1, x2) - cellSize, mathMax(x1, x2) + cellSize, \
                        mathMin(y1, y2) - cellSize, mathMax(y1, y2) + cellSize):
                    continue
                endif

                count = mathMax(1, mathCeil(mathSqrt((x2 - x1) ** 2 + (y2 - y1) ** 2) / (cellSize * 0.5)))
                ixStep = 0
                pointB = null
                ixPointB = -1
                while ixStep < count:
                    xa = x1 + (x2 - x1) * ixStep / count
                    ya = y1 + (y2 - y1) * ixStep / count
                    xb = x1 + (x2 - x1) * (ixStep + 1) / count
                    yb = y1 + (y2 - y1) * (ixStep + 1) / count
                    if cullBox == null || !roadieOutsideBox(cullBox, mathMin(xa, xb), mathMax(xa, xb), mathMin(ya, yb), mathMax(ya, yb)):
                        # The step's projected end points - its start is the previous step's end, if that was projected
                        pointA = if(ixPointB == ixStep, pointB, roadieProjectGround(view, topo, xa, ya))
                        pointB = roadieProjectGround(view, topo, xb, yb)
                        ixPointB = ixStep + 1
                        if pointA != null && pointB != null:
                            pxa = arrayGet(pointA, 0)
                            pya = arrayGet(pointA, 1)
                            pxb = arrayGet(pointB, 0)
                            pyb = arrayGet(pointB, 1)
                            if mathMax(pxa, pxb) >= 0 && mathMin(pxa, pxb) <= width && mathMax(pya, pyb) >= 0 && mathMin(pya, pyb) <= viewHeight:
                                arrayPush(items, [(arrayGet(pointA, 2) + arrayGet(pointB, 2)) / 2 - cellSize * 0.5, \
                                    roadieSvgPolyline([pxa, pya, pxb, pyb], stroke, if(type == 'stream', 2.5, 1), \
                                        if(type == 'stream', null, '4 3'))])
                            endif
                        endif
                    endif
                    ixStep = ixStep + 1
                endwhile
            endif
        endfor
    endfor

    # Road
    bias = cellSize
    surfaceColor = objectGet(roadieColors, objectGet(section, 'surface', 'gravel'))
    deckDepth = roadieUnitLength(plan, 1, 3)
    prevPoints = null
    for sample, ixSample in samples:
        points = roadieSamplePoints(sample, halfWidth)
        if ixSample > 0:
            prev = arrayGet(samples, ixSample - 1)

            # Skip the road interval if its footprint is outside the view's ground area
            if cullBox != null:
                reach = halfWidth + mathMax(objectGet(objectGet(prev, 'left'), 'offset'), objectGet(objectGet(prev, 'right'), 'offset'), \
                    objectGet(objectGet(sample, 'left'), 'offset'), objectGet(objectGet(sample, 'right'), 'offset'))
                if roadieOutsideBox(cullBox, mathMin(objectGet(prev, 'x'), objectGet(sample, 'x')) - reach, \
                        mathMax(objectGet(prev, 'x'), objectGet(sample, 'x')) + reach, \
                        mathMin(objectGet(prev, 'y'), objectGet(sample, 'y')) - reach, \
                        mathMax(objectGet(prev, 'y'), objectGet(sample, 'y')) + reach):
                    prevPoints = points
                    continue
                endif
            endif

            bridge = objectGet(prev, 'bridge') && objectGet(sample, 'bridge')
            existing = objectGet(prev, 'existing') && objectGet(sample, 'existing')
            title = roadieStation(objectGet(sample, 'station'), units) + if(existing, ' (existing road)', '') + ': grade ' + \
                numberToFixed(objectGet(sample, 'z'), 1) + ', ground ' + numberToFixed(objectGet(sample, 'ground'), 1) + ', ' + \
                if(objectGet(sample, 'ground') >= objectGet(sample, 'z'), 'cut ', 'fill ') + \
                numberToFixed(mathAbs(objectGet(sample, 'ground') - objectGet(sample, 'z')), 1)

            # Road surface (or bridge deck)
            surfacePoints = [arrayGet(prevPoints, 1), arrayGet(points, 1), arrayGet(points, 2), arrayGet(prevPoints, 2)]
            roadiePushItem(items, roadie3DPolygon(view, surfacePoints, \
                if(bridge, objectGet(roadieColors, 'bridge'), if(existing, objectGet(roadieColors, 'existing'), surfaceColor)), bias, title))
            if bridge:
                for ixEdge in [1, 2]:
                    edgePrev = arrayGet(prevPoints, ixEdge)
                    edge = arrayGet(points, ixEdge)
                    roadiePushItem(items, roadie3DPolygon(view, [ \
                        edgePrev, edge, \
                        [arrayGet(edge, 0), arrayGet(edge, 1), arrayGet(edge, 2) - deckDepth], \
                        [arrayGet(edgePrev, 0), arrayGet(edgePrev, 1), arrayGet(edgePrev, 2) - deckDepth] \
                    ], objectGet(roadieColors, 'bridge'), bias * 1.1, null))
                endfor
                prevPoints = points
                continue
            endif

            # Side slopes and walls
            for sideInfo in [['left', 0, 1], ['right', 3, 2]]:
                side = objectGet(sample, arrayGet(sideInfo, 0))
                sidePrev = objectGet(prev, arrayGet(sideInfo, 0))
                kind = objectGet(side, 'kind')
                kindPrev = objectGet(sidePrev, 'kind')
                ixDaylight = arrayGet(sideInfo, 1)
                ixEdge = arrayGet(sideInfo, 2)
                edgePrev = arrayGet(prevPoints, ixEdge)
                edge = arrayGet(points, ixEdge)
                if kind == 'wall' || kindPrev == 'wall':
                    roadiePushItem(items, roadie3DPolygon(view, [ \
                        edgePrev, edge, \
                        [arrayGet(edge, 0), arrayGet(edge, 1), arrayGet(edge, 2) + objectGet(side, 'drop')], \
                        [arrayGet(edgePrev, 0), arrayGet(edgePrev, 1), arrayGet(edgePrev, 2) + objectGet(sidePrev, 'drop')] \
                    ], objectGet(roadieColors, 'wall'), bias * 0.9, null))
                elif kind != 'none' || kindPrev != 'none':
                    slopeKind = if(kind != 'none', kind, kindPrev)
                    roadiePushItem(items, roadie3DPolygon(view, \
                        [edgePrev, arrayGet(prevPoints, ixDaylight), arrayGet(points, ixDaylight), edge], \
                        objectGet(roadieColors, slopeKind), bias * 0.9, null))
                endif
            endfor
        endif
        prevPoints = points
    endfor

    # A road narrower than the minimum drawn width is also drawn as a highlighted centerline (a white halo under a
    # colored line) - each segment is depth-sorted with the terrain, so hills still hide the road behind them. The
    # colored lines are biased several road sample intervals nearer than the halos, so a neighboring segment's halo
    # never covers them, however small the terrain cells.
    sampleInterval = objectGet(arrayGet(samples, 1), 'station') - objectGet(arrayGet(samples, 0), 'station')
    lineBias = bias * 1.2 + mathMax(bias * 0.3, 4 * sampleInterval)
    labelBias = lineBias + bias * 0.5
    if 2 * halfWidth * scale < roadieMinRoadPx:
        for sample, ixSample in samples:
            if ixSample > 0:
                prev = arrayGet(samples, ixSample - 1)
                projected = roadieProjectPoints(view, [ \
                    [objectGet(prev, 'x'), objectGet(prev, 'y'), objectGet(prev, 'z')], \
                    [objectGet(sample, 'x'), objectGet(sample, 'y'), objectGet(sample, 'z')] \
                ])
                if roadieCoordsVisible(view, arrayGet(projected, 0)):
                    depth = arrayGet(projected, 1)
                    arrayPush(items, [depth - bias * 1.2, roadieSvgPolyline(arrayGet(projected, 0), 'white', 6)])
                    arrayPush(items, [depth - lineBias, roadieSvgPolyline(arrayGet(projected, 0), roadieRoadColor, 3)])
                endif
            endif
        endfor
    endif

    # Culverts
    for structure in objectGet(option, 'structures', []):
        if objectGet(structure, 'type') == 'culvert':
            sample = roadieSampleAt(samples, objectGet(structure, 'station'))
            points = roadieSamplePoints(sample, halfWidth)
            projected = roadieProjectPoints(view, [arrayGet(points, 0), arrayGet(points, 3)])
            arrayPush(items, [arrayGet(projected, 1) - bias * 1.2, \
                roadieSvgPolyline(arrayGet(projected, 0), '#2a6fdb', 4)])
        endif
    endfor

    # Station labels, about a fifth of the view's width apart - depth-sorted with the terrain
    length = objectGet(analysis, 'length')
    labelStep = roadieNiceStep(width / scale, 5)
    station = labelStep
    while station < length - labelStep * 0.25:
        sample = roadieSampleAt(samples, station)
        projected = roadieProject(view, objectGet(sample, 'x'), objectGet(sample, 'y'), objectGet(sample, 'z'))
        px = arrayGet(projected, 0)
        py = arrayGet(projected, 1)
        if px >= 0 && px <= width && py >= 0 && py <= viewHeight:
            arrayPush(items, [arrayGet(projected, 2) - labelBias, [ \
                {'svg': 'circle', 'attr': {'cx': roadiePx(px), 'cy': roadiePx(py), 'r': 3, 'fill': '#222', 'stroke': 'white'}}, \
                roadieSvgText(roadieStation(station, units), px + 6, py - 9, 11, 'start', '#222', false) \
            ]])
        endif
        station = station + labelStep
    endwhile

    # Sort the items by depth, farthest first
    items = roadieSortDepth(items)
    elements = []
    for item in items:
        arrayPush(elements, arrayGet(item, 1))
    endfor

    # Start and end markers (always on top) - the poles are the same height on screen at any zoom
    poleHeight = roadie3DPoleHeight(topo, exaggeration) / objectGet(view, 'zoom')
    for marker in [[objectGet(plan, 'start'), 'Start', '#1a8f3c'], [objectGet(plan, 'end'), 'End', '#c0392b']]:
        point = arrayGet(marker, 0)
        x = objectGet(point, 'x')
        y = objectGet(point, 'y')
        z = roadieElevation(topo, x, y)
        z = if(z == null, minZ, z)
        base = roadieProject(view, x, y, z)
        top = roadieProject(view, x, y, z + poleHeight)
        arrayPush(elements, roadieSvgPolyline([arrayGet(base, 0), arrayGet(base, 1), arrayGet(top, 0), arrayGet(top, 1)], \
            arrayGet(marker, 2), 2.5))
        label = objectGet(point, 'label', arrayGet(marker, 1))
        arrayPush(elements, roadieSvgText(label, roadieLabelX(label, 13, arrayGet(top, 0), width), arrayGet(top, 1) - 9, 13, \
            'middle', arrayGet(marker, 2), true))
    endfor

    # Compass
    arrayPush(elements, roadieCompass(view, width - 36, 36))

    return roadieSvg(width, viewHeight, '3D view of the ' + objectGet(option, 'name') + ' road plan option', elements)
endfunction


# Create a compass element model showing north for a view
function roadieCompass(view, cx, cy):
    north = roadieProject(view, objectGet(view, 'xc'), objectGet(view, 'yc') + 1, objectGet(view, 'zc'))
    center = roadieProject(view, objectGet(view, 'xc'), objectGet(view, 'yc'), objectGet(view, 'zc'))
    dx = arrayGet(north, 0) - arrayGet(center, 0)
    dy = arrayGet(north, 1) - arrayGet(center, 1)
    length = mathSqrt(dx * dx + dy * dy)
    ux = dx / length
    uy = dy / length
    return [ \
        {'svg': 'circle', 'attr': {'cx': cx, 'cy': cy, 'r': 22, 'fill': 'white', 'fill-opacity': 0.8, 'stroke': '#888'}}, \
        roadieSvgPolygon( \
            [cx + ux * 18, cy + uy * 18, cx - uy * 6, cy + ux * 6, cx + uy * 6, cy - ux * 6], \
            '#c0392b', '#c0392b', 1 \
        ), \
        roadieSvgText('N', cx - ux * 12, cy - uy * 12, 11, 'middle', '#333', true) \
    ]
endfunction


#
# Plan view
#


# Create the plan view SVG element model - "outlines" is an array of [number, view, [x, y]] arrays of 3D views
# (roadieProjection) whose visible areas are outlined, with their numbers marked on the road at [x, y]
function roadiePlanView(plan, topo, analyses, ixOption, width, outlines):
    units = objectGet(plan, 'units')
    spacing = objectGet(topo, 'spacing')
    nRows = objectGet(topo, 'nRows')
    nCols = objectGet(topo, 'nCols')
    topoHeight = objectGet(topo, 'height')
    pad = 10
    scale = (width - 2 * pad) / objectGet(topo, 'width')
    height = mathRound(topoHeight * scale + 2 * pad)
    elements = []

    # Contours
    contourInterval = roadieContourInterval(plan, topo)
    rows = objectGet(topo, 'rows')
    minorPath = []
    indexPath = []
    row = 0
    while row < nRows - 1:
        rowTop = arrayGet(rows, row)
        rowBottom = arrayGet(rows, row + 1)
        col = 0
        while col < nCols - 1:
            zNW = arrayGet(rowTop, col)
            zNE = arrayGet(rowTop, col + 1)
            zSE = arrayGet(rowBottom, col + 1)
            zSW = arrayGet(rowBottom, col)
            level = mathCeil(mathMin(zNW, zNE, zSE, zSW) / contourInterval) * contourInterval
            zMax = mathMax(zNW, zNE, zSE, zSW)
            while level <= zMax:
                indexLevel = level / contourInterval / 5
                isIndex = mathAbs(indexLevel - mathFloor(indexLevel + 0.5)) < 1e-6
                for segment in roadieCellContours(zNW, zNE, zSE, zSW, level):
                    arrayPush(if(isIndex, indexPath, minorPath), \
                        'M' + numberToFixed(pad + (col + arrayGet(segment, 0)) * spacing * scale, 1, true) + ' ' + \
                            numberToFixed(pad + (row + arrayGet(segment, 1)) * spacing * scale, 1, true) + \
                        'L' + numberToFixed(pad + (col + arrayGet(segment, 2)) * spacing * scale, 1, true) + ' ' + \
                            numberToFixed(pad + (row + arrayGet(segment, 3)) * spacing * scale, 1, true))
                endfor
                level = level + contourInterval
            endwhile
            col = col + 1
        endwhile
        row = row + 1
    endwhile
    arrayPush(elements, {'svg': 'path', 'attr': {'d': arrayJoin(minorPath, ''), 'fill': 'none', 'stroke': '#b89a72', 'stroke-width': 0.6}})
    arrayPush(elements, {'svg': 'path', 'attr': {'d': arrayJoin(indexPath, ''), 'fill': 'none', 'stroke': '#8a6a45', 'stroke-width': 1.3}})

    # Features
    for feature in objectGet(topo, 'features'):
        type = objectGet(feature, 'type')
        coords = []
        sumX = 0
        sumY = 0
        for point in objectGet(feature, 'points'):
            px = pad + objectGet(point, 'x') * scale
            py = pad + (topoHeight - objectGet(point, 'y')) * scale
            arrayPush(coords, px, py)
            sumX = sumX + px
            sumY = sumY + py
        endfor
        if type == 'stream':
            arrayPush(elements, roadieSvgPolyline(coords, '#2a6fdb', 2.5))
        elif type == 'rock':
            arrayPush(elements, roadieSvgPolygon(coords, 'rgba(110,110,110,0.35)', '#555555', 1))
        else:
            arrayPush(elements, roadieSvgPolygon(coords, 'rgba(208,49,45,0.12)', '#d0312d', 1.5))
        endif
        name = objectGet(feature, 'name')
        if name != null:
            count = arrayLength(objectGet(feature, 'points'))
            arrayPush(elements, roadieSvgText(name, sumX / count, sumY / count, 11, 'middle', \
                if(type == 'stream', '#1d4f9e', '#444'), false))
        endif
    endfor

    # Other options' centerlines
    for analysis, ixAnalysis in analyses:
        if ixAnalysis != ixOption:
            coords = []
            for point in objectGet(analysis, 'alignment'):
                arrayPush(coords, pad + objectGet(point, 'x') * scale, pad + (topoHeight - objectGet(point, 'y')) * scale)
            endfor
            arrayPush(elements, roadieSvgPolyline(coords, '#777777', 1.5, '6 4'))
        endif
    endfor

    # The selected option's footprint
    analysis = arrayGet(analyses, ixOption)
    option = arrayGet(objectGet(plan, 'options'), ixOption)
    section = objectGet(option, 'section')
    halfWidth = objectGet(section, 'width') * 0.5
    samples = objectGet(analysis, 'samples')
    surfaceFill = roadieRGB(objectGet(roadieColors, objectGet(section, 'surface', 'gravel')))
    bridgeFill = roadieRGB(objectGet(roadieColors, 'bridge'))
    existingFill = roadieRGB(objectGet(roadieColors, 'existing'))
    prevCoords = null
    for sample, ixSample in samples:
        coords = []
        for point in roadieSamplePoints(sample, halfWidth):
            arrayPush(coords, pad + arrayGet(point, 0) * scale, pad + (topoHeight - arrayGet(point, 1)) * scale)
        endfor
        if ixSample > 0:
            prev = arrayGet(samples, ixSample - 1)
            for sideInfo in [['left', 0, 1], ['right', 3, 2]]:
                kind = objectGet(objectGet(sample, arrayGet(sideInfo, 0)), 'kind')
                kindPrev = objectGet(objectGet(prev, arrayGet(sideInfo, 0)), 'kind')
                ixEdge = arrayGet(sideInfo, 2)
                if kind == 'wall' || kindPrev == 'wall':
                    arrayPush(elements, roadieSvgPolyline([ \
                        arrayGet(prevCoords, ixEdge * 2), arrayGet(prevCoords, ixEdge * 2 + 1), \
                        arrayGet(coords, ixEdge * 2), arrayGet(coords, ixEdge * 2 + 1) \
                    ], '#333333', 3))
                elif kind == 'cut' || kind == 'fill':
                    ixDay = arrayGet(sideInfo, 1)
                    color = roadieRGB(objectGet(roadieColors, kind))
                    arrayPush(elements, roadieSvgPolygon([ \
                        arrayGet(prevCoords, ixEdge * 2), arrayGet(prevCoords, ixEdge * 2 + 1), \
                        arrayGet(prevCoords, ixDay * 2), arrayGet(prevCoords, ixDay * 2 + 1), \
                        arrayGet(coords, ixDay * 2), arrayGet(coords, ixDay * 2 + 1), \
                        arrayGet(coords, ixEdge * 2), arrayGet(coords, ixEdge * 2 + 1) \
                    ], color, color, 0.5))
                endif
            endfor
            fill = if(objectGet(prev, 'bridge') && objectGet(sample, 'bridge'), bridgeFill, \
                if(objectGet(prev, 'existing') && objectGet(sample, 'existing'), existingFill, surfaceFill))
            arrayPush(elements, roadieSvgPolygon([ \
                arrayGet(prevCoords, 2), arrayGet(prevCoords, 3), arrayGet(coords, 2), arrayGet(coords, 3), \
                arrayGet(coords, 4), arrayGet(coords, 5), arrayGet(prevCoords, 4), arrayGet(prevCoords, 5) \
            ], fill, fill, 0.5))
        endif
        prevCoords = coords
    endfor

    # A road narrower than the minimum drawn width is also drawn as a highlighted centerline
    if 2 * halfWidth * scale < roadieMinRoadPx:
        coords = []
        for sample in samples:
            arrayPush(coords, pad + objectGet(sample, 'x') * scale, pad + (topoHeight - objectGet(sample, 'y')) * scale)
        endfor
        arrayPush(elements, roadieSvgPolyline(coords, 'white', 6))
        arrayPush(elements, roadieSvgPolyline(coords, roadieRoadColor, 3))
    endif

    # Culverts
    for structure in objectGet(option, 'structures', []):
        if objectGet(structure, 'type') == 'culvert':
            sample = roadieSampleAt(samples, objectGet(structure, 'station'))
            points = roadieSamplePoints(sample, halfWidth)
            pointLeft = arrayGet(points, 0)
            pointRight = arrayGet(points, 3)
            arrayPush(elements, roadieSvgPolyline([ \
                pad + arrayGet(pointLeft, 0) * scale, pad + (topoHeight - arrayGet(pointLeft, 1)) * scale, \
                pad + arrayGet(pointRight, 0) * scale, pad + (topoHeight - arrayGet(pointRight, 1)) * scale \
            ], '#2a6fdb', 3))
        endif
    endfor

    # Station ticks
    length = objectGet(analysis, 'length')
    tickStep = roadieNiceStep(length, 8)
    station = tickStep
    while station < length:
        sample = roadieSampleAt(samples, station)
        px = pad + objectGet(sample, 'x') * scale
        py = pad + (topoHeight - objectGet(sample, 'y')) * scale
        arrayPush(elements, {'svg': 'circle', 'attr': {'cx': roadiePx(px), 'cy': roadiePx(py), 'r': 2.5, 'fill': '#222'}})
        arrayPush(elements, roadieSvgText(roadieStation(station, units), px + 6, py - 8, 10, 'start', '#222', false))
        station = station + tickStep
    endwhile

    # Start and end markers
    for marker in [[objectGet(plan, 'start'), 'Start', '#1a8f3c'], [objectGet(plan, 'end'), 'End', '#c0392b']]:
        point = arrayGet(marker, 0)
        px = pad + objectGet(point, 'x') * scale
        py = pad + (topoHeight - objectGet(point, 'y')) * scale
        arrayPush(elements, {'svg': 'circle', 'attr': {'cx': roadiePx(px), 'cy': roadiePx(py), 'r': 6, \
            'fill': arrayGet(marker, 2), 'stroke': 'white', 'stroke-width': 2}})
        label = objectGet(point, 'label', arrayGet(marker, 1))
        arrayPush(elements, roadieSvgText(label, roadieLabelX(label, 13, px, width), py - 14, 13, 'middle', arrayGet(marker, 2), true))
    endfor

    # Scale bar
    barLength = roadieNiceStep(objectGet(topo, 'width'), 5)
    barPx = barLength * scale
    barY = height - pad - 12
    arrayPush(elements, {'svg': 'rect', 'attr': {'x': pad + 8, 'y': barY - 14, 'width': roadiePx(barPx + 16), 'height': 26, \
        'fill': 'white', 'fill-opacity': 0.8}})
    arrayPush(elements, roadieSvgPolyline([pad + 16, barY, pad + 16 + barPx, barY], '#222', 3))
    arrayPush(elements, roadieSvgText(roadieNumber(barLength, 0) + ' ' + roadieUnitLabel(units, 'length') + \
        ' — contours ' + numberToFixed(contourInterval, 2, true) + ' ' + roadieUnitLabel(units, 'length'), \
        pad + 16, barY - 7, 10, 'start', '#222', false))

    # North arrow
    arrayPush(elements, roadieSvgPolygon([width - 30, pad + 8, width - 37, pad + 28, width - 23, pad + 28], '#222', '#222', 1))
    arrayPush(elements, roadieSvgText('N', width - 30, pad + 38, 11, 'middle', '#222', true))

    # The 3D views' visible areas - their corners projected onto the ground - as light dashed outlines, then their
    # numbers marked on the road (on top of the outlines)
    for outline in outlines:
        view = arrayGet(outline, 1)
        coords = []
        viewWidth = objectGet(view, 'width')
        viewHeight = objectGet(view, 'height')
        for corner in [[0, 0], [viewWidth, 0], [viewWidth, viewHeight], [0, viewHeight]]:
            point = roadieUnproject(view, topo, arrayGet(corner, 0), arrayGet(corner, 1))
            arrayPush(coords, pad + arrayGet(point, 0) * scale, pad + (topoHeight - arrayGet(point, 1)) * scale)
        endfor
        area = roadieSvgPolygon(coords, 'none', 'rgba(31,78,140,0.55)', 1, '3D view ' + arrayGet(outline, 0) + ' area')
        objectSet(objectGet(area, 'attr'), 'stroke-dasharray', '5 4')
        arrayPush(elements, area)
    endfor
    for outline in outlines:
        marker = arrayGet(outline, 2)
        px = pad + arrayGet(marker, 0) * scale
        py = pad + (topoHeight - arrayGet(marker, 1)) * scale
        arrayPush(elements, {'svg': 'circle', 'attr': {'cx': roadiePx(px), 'cy': roadiePx(py), 'r': 9, \
            'fill': '#1f4e8c', 'stroke': 'white', 'stroke-width': 1.5}})
        arrayPush(elements, {'svg': 'text', 'attr': {'x': roadiePx(px), 'y': roadiePx(py), 'font-size': 11, \
            'font-family': 'sans-serif', 'font-weight': 'bold', 'text-anchor': 'middle', 'dominant-baseline': 'central', \
            'fill': 'white'}, 'elem': {'text': arrayGet(outline, 0)}})
    endfor

    svg = roadieSvg(width, height, 'Plan view of the ' + objectGet(option, 'name') + ' road plan option', elements)
    objectSet(objectGet(svg, 'attr'), 'style', objectGet(objectGet(svg, 'attr'), 'style') + ' cursor: crosshair;')
    objectSet(svg, 'callback', {'click': systemPartial(roadieOnPlanClick, topo, width, height, pad, scale)})
    return svg
endfunction


#
# Profile view
#


# Create the profile view SVG element model
function roadieProfileView(plan, option, analysis, width, height):
    units = objectGet(plan, 'units')
    lengthUnit = roadieUnitLabel(units, 'length')
    samples = objectGet(analysis, 'samples')
    length = mathMax(objectGet(analysis, 'length'), 1e-9)
    maxGrade = objectGet(roadieCriteria(plan), 'maxGrade')
    elements = []

    # Elevation range
    minZ = null
    maxZ = null
    for sample in samples:
        low = mathMin(objectGet(sample, 'z'), objectGet(sample, 'ground'))
        high = mathMax(objectGet(sample, 'z'), objectGet(sample, 'ground'))
        minZ = if(minZ == null, low, mathMin(minZ, low))
        maxZ = if(maxZ == null, high, mathMax(maxZ, high))
    endfor
    zStep = roadieNiceStep(maxZ - minZ, 6)
    minZ = mathFloor(minZ / zStep) * zStep - zStep
    maxZ = mathCeil(maxZ / zStep) * zStep

    # Plot area
    left = 64
    right = width - 16
    top = 16
    bottom = height - 40
    xScale = (right - left) / length
    yScale = (bottom - top) / (maxZ - minZ)

    # Grid and axes
    z = minZ
    while z <= maxZ + 1e-9:
        py = bottom - (z - minZ) * yScale
        arrayPush(elements, roadieSvgPolyline([left, py, right, py], '#dddddd', 1))
        arrayPush(elements, roadieSvgText(roadieNumber(z, 0), left - 6, py, 10, 'end', '#444', false))
        z = z + zStep
    endwhile
    stationStep = roadieNiceStep(length, 10)
    station = 0
    while station <= length + 1e-9:
        px = left + station * xScale
        arrayPush(elements, roadieSvgPolyline([px, top, px, bottom], '#dddddd', 1))
        arrayPush(elements, roadieSvgText(roadieStation(station, units), px, bottom + 14, 10, 'middle', '#444', false))
        station = station + stationStep
    endwhile
    arrayPush(elements, roadieSvgText('Station', (left + right) * 0.5, height - 10, 11, 'middle', '#444', true))
    arrayPush(elements, roadieSvgText('Elevation (' + lengthUnit + ') — vertical exaggeration ' + \
        numberToFixed(yScale / xScale, 1, true) + 'x', left + 6, top + 8, 11, 'start', '#444', true))

    # Cut and fill areas
    ixRun = 0
    while ixRun < arrayLength(samples) - 1:
        sample = arrayGet(samples, ixRun)
        isCut = objectGet(sample, 'ground') >= objectGet(sample, 'z')
        isBridge = objectGet(sample, 'bridge')
        ixEnd = ixRun + 1
        while ixEnd < arrayLength(samples) - 1 && \
                (objectGet(arrayGet(samples, ixEnd), 'ground') >= objectGet(arrayGet(samples, ixEnd), 'z')) == isCut && \
                objectGet(arrayGet(samples, ixEnd), 'bridge') == isBridge:
            ixEnd = ixEnd + 1
        endwhile
        if !isBridge:
            gradeCoords = []
            groundCoords = []
            ixSample = ixRun
            while ixSample <= ixEnd:
                runSample = arrayGet(samples, ixSample)
                px = left + objectGet(runSample, 'station') * xScale
                arrayPush(gradeCoords, px, bottom - (objectGet(runSample, 'z') - minZ) * yScale)
                arrayPush(groundCoords, bottom - (objectGet(runSample, 'ground') - minZ) * yScale, px)
                ixSample = ixSample + 1
            endwhile
            arrayExtend(gradeCoords, arrayReverse(groundCoords))
            color = roadieRGB(objectGet(roadieColors, if(isCut, 'cut', 'fill')))
            arrayPush(elements, roadieSvgPolygon(gradeCoords, color, color, 0.5))
        endif
        ixRun = ixEnd
    endwhile

    # Ground line
    groundCoords = []
    for sample in samples:
        arrayPush(groundCoords, left + objectGet(sample, 'station') * xScale, bottom - (objectGet(sample, 'ground') - minZ) * yScale)
    endfor
    arrayPush(elements, roadieSvgPolyline(groundCoords, '#6b4a2b', 1.5))

    # Structures - the wall and turnout labels share a row, so a label that would overlap the previous one is omitted
    labelRight = null
    for structure in objectGet(option, 'structures', []):
        type = objectGet(structure, 'type')
        station = objectGet(structure, 'station')
        endStation = objectGet(structure, 'endStation', station)
        px1 = left + station * xScale
        px2 = left + endStation * xScale
        if type == 'bridge':
            sample1 = roadieSampleAt(samples, station)
            sample2 = roadieSampleAt(samples, endStation)
            py1 = bottom - (objectGet(sample1, 'z') - minZ) * yScale
            py2 = bottom - (objectGet(sample2, 'z') - minZ) * yScale
            arrayPush(elements, roadieSvgPolygon([px1, py1, px2, py2, px2, py2 + 6, px1, py1 + 6], '#786858', '#786858', 1))
            arrayPush(elements, roadieSvgText('Bridge', (px1 + px2) * 0.5, mathMin(py1, py2) - 10, 10, 'middle', '#444', true))
        elif type == 'culvert':
            sample = roadieSampleAt(samples, station)
            py = bottom - (objectGet(sample, 'ground') - minZ) * yScale
            arrayPush(elements, {'svg': 'circle', 'attr': {'cx': roadiePx(px1), 'cy': roadiePx(py), 'r': 5, \
                'fill': 'white', 'stroke': '#2a6fdb', 'stroke-width': 2.5}})
        else:
            color = if(type == 'retainingWall', '#555555', if(type == 'existingRoad', '#706e68', '#2a8f8f'))
            if type == 'existingRoad':
                # The existing road's (as-built) section is shaded
                arrayPush(elements, {'svg': 'rect', 'attr': {'x': roadiePx(px1), 'y': top, 'width': roadiePx(mathMax(2, px2 - px1)), \
                    'height': bottom - top, 'fill': 'rgba(112,110,104,0.12)'}})
            endif
            arrayPush(elements, {'svg': 'rect', 'attr': {'x': roadiePx(px1), 'y': bottom - 8, 'width': roadiePx(mathMax(2, px2 - px1)), \
                'height': 8, 'fill': color}})
            label = if(type == 'retainingWall', 'Wall', if(type == 'existingRoad', 'Existing road', 'Turnout'))
            halfLabel = stringLength(label) * 10 * 0.32
            labelX = (px1 + px2) * 0.5
            if labelRight == null || labelX - halfLabel > labelRight + 4:
                arrayPush(elements, roadieSvgText(label, labelX, bottom - 16, 10, 'middle', color, true))
                labelRight = labelX + halfLabel
            endif
        endif
    endfor

    # Grade line - steep segments are highlighted
    for grade in objectGet(analysis, 'grades'):
        steep = !objectGet(grade, 'existing') && mathAbs(objectGet(grade, 'grade')) > maxGrade + 1e-6
        sample1 = roadieAlignmentPointAt(analysis, objectGet(grade, 'station'))
        sample2 = roadieAlignmentPointAt(analysis, objectGet(grade, 'endStation'))
        arrayPush(elements, roadieSvgPolyline([ \
            left + objectGet(grade, 'station') * xScale, bottom - (objectGet(sample1, 'z') - minZ) * yScale, \
            left + objectGet(grade, 'endStation') * xScale, bottom - (objectGet(sample2, 'z') - minZ) * yScale \
        ], if(steep, '#e01e1e', '#1f2d3d'), if(steep, 3, 2)))
    endfor

    # Legend
    legendX = right - 250
    for legend, ixLegend in [['Cut', roadieRGB(objectGet(roadieColors, 'cut'))], ['Fill', roadieRGB(objectGet(roadieColors, 'fill'))], \
            ['Ground', '#6b4a2b'], ['Grade', '#1f2d3d'], ['Over ' + numberToFixed(maxGrade, 1, true) + '%', '#e01e1e']]:
        lx = legendX + ixLegend * 50
        arrayPush(elements, {'svg': 'rect', 'attr': {'x': lx, 'y': top + 2, 'width': 10, 'height': 10, 'fill': arrayGet(legend, 1)}})
        arrayPush(elements, roadieSvgText(arrayGet(legend, 0), lx + 13, top + 8, 10, 'start', '#444', false))
    endfor

    return roadieSvg(width, height, 'Profile of the ' + objectGet(option, 'name') + ' road plan option', elements)
endfunction


# Find the alignment point at a station
function roadieAlignmentPointAt(analysis, station):
    # Binary search for the first point at or beyond the station (alignment stations are non-decreasing)
    alignment = objectGet(analysis, 'alignment')
    ixLow = 0
    ixHigh = arrayLength(alignment)
    while ixLow < ixHigh:
        ixMid = mathFloor((ixLow + ixHigh) / 2)
        if objectGet(arrayGet(alignment, ixMid), 'station') >= station - 1e-9:
            ixHigh = ixMid
        else:
            ixLow = ixMid + 1
        endif
    endwhile
    return if(ixLow < arrayLength(alignment), arrayGet(alignment, ixLow))
endfunction
