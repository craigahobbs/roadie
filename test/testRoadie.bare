    unittestEqual(roadieContourInterval({'topography': {}}, {'minZ': 0, 'maxZ': 100}), 5)
endfunction
unittestRunTest('testRoadieContourInterval')


function testRoadieCellContours():
    unittestDeepEqual(roadieCellContours(1, 2, 3, 4, 10), [])
    unittestDeepEqual(roadieCellContours(0, 10, 10, 0, 5), [[0.5, 0, 0.5, 1]])
    unittestDeepEqual(roadieCellContours(10, 0, 10, 0, 5), [[0.5, 0, 1, 0.5], [0.5, 1, 0, 0.5]])
endfunction
unittestRunTest('testRoadieCellContours')


function testRoadieSvgElements():
    unittestEqual(roadiePx(1.25), '1.3')
    unittestEqual(roadiePx(2), '2')
    unittestDeepEqual(roadieSvgPolygon([0, 0, 10, 0, 10, 5.55], 'red', 'blue', 1, null), \
        {'svg': 'polygon', 'attr': {'points': '0,0 10,0 10,5.6', 'fill': 'red', 'stroke': 'blue', 'stroke-width': 1}})
    unittestDeepEqual(roadieSvgPolygon([0, 0, 10, 0, 10, 5], 'red', 'red', 0.5, 'Tip'), { \
        'svg': 'polygon', \
        'attr': {'points': '0,0 10,0 10,5', 'fill': 'red', 'stroke': 'red', 'stroke-width': 0.5}, \
        'elem': {'svg': 'title', 'elem': {'text': 'Tip'}} \
    })
    unittestDeepEqual(roadieSvgPolyline([0, 0, 10, 5], 'blue', 2, null), {'svg': 'polyline', 'attr': { \
        'points': '0,0 10,5', 'fill': 'none', 'stroke': 'blue', 'stroke-width': 2, 'stroke-linejoin': 'round', \
        'stroke-linecap': 'round'}})
    unittestDeepEqual(roadieSvgPolyline([0, 0, 10, 5], 'blue', 2, '4 3'), {'svg': 'polyline', 'attr': { \
        'points': '0,0 10,5', 'fill': 'none', 'stroke': 'blue', 'stroke-width': 2, 'stroke-linejoin': 'round', \
        'stroke-linecap': 'round', 'stroke-dasharray': '4 3'}})
    unittestDeepEqual(roadieSvgText('Hi', 1, 2, 10, 'start', 'black', false), {'svg': 'text', 'attr': { \
        'x': '1', 'y': '2', 'font-size': 10, 'font-family': 'sans-serif', 'text-anchor': 'start', \
        'dominant-baseline': 'middle', 'fill': 'black', 'stroke': 'white', 'stroke-width': 3, 'paint-order': 'stroke'}, \
        'elem': {'text': 'Hi'}})
    unittestEqual(objectGet(objectGet(roadieSvgText('Hi', 1, 2, 10, 'start', 'black', true), 'attr'), 'font-weight'), 'bold')
    unittestDeepEqual(roadieSvg(100, 50, 'Label', []), {'svg': 'svg', 'attr': { \
        'width': 100, 'height': 50, 'viewBox': '0 0 100 50', 'role': 'img', 'aria-label': 'Label', \
        'style': 'background: #f4f1ea; border: 1px solid #ccc; display: block; max-width: 100%; height: auto; break-inside: avoid; margin: 0.75em 0 1.5em 0;'}, \
        'elem': []})
endfunction
unittestRunTest('testRoadieSvgElements')


