function testRoadieExploreRender():
    systemGlobalSet('vFile', 'a.json')
    systemGlobalSet('vExplore', true)
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    context = roadieExploreContext(argsParse(roadieArguments), plan)
    unittestMockAll()
    roadieExploreRender(context)
    log = unittestMockEnd()

    # The view fills the window, less the body margins (the mock window is 1024 x 768)
    unittestDeepEqual(arrayGet(log, 0), ['documentSetReset', ['roadie-explore']])
    svg = arrayGet(arrayGet(arrayGet(log, 1), 1), 0)
    unittestDeepEqual([objectGet(objectGet(svg, 'attr'), 'width'), objectGet(objectGet(svg, 'attr'), 'height')], [976, 720])
    unittestEqual(stringEndsWith(objectGet(objectGet(svg, 'attr'), 'style'), ' margin: 0;'), true)
    view = objectGet(context, 'view')
    unittestDeepEqual([objectGet(view, 'width'), objectGet(view, 'height'), objectGet(view, 'cy')], [976, 720, 360])

    # The overlays - the report link, the keyboard help, and the view status
    elements = objectGet(svg, 'elem')
    count = arrayLength(elements)
    unittestDeepEqual(arrayGet(elements, count - 12), {'svg': 'a', 'attr': {'href': "#var.vFile='a.json'"}, \
        'elem': roadieSvgText('Back to the report', 12, 20, 14, 'start', '#1f4e8c', true)})
    unittestEqual(objectGet(arrayGet(elements, count - 11), 'svg'), 'rect')
    unittestEqual(objectGet(objectGet(arrayGet(elements, count - 10), 'elem'), 'text'), 'Arrows or W A S D - move')
    unittestEqual(objectGet(objectGet(arrayGet(elements, count - 1), 'elem'), 'text'), \
        'Center x 20, y 20, z 107 m - zoom 1x, rotation 30, tilt 35, exaggeration 1.5x, faceted terrain')

    # Without the help, its hint
    objectSet(objectGet(context, 'state'), 'help', false)
    unittestMockAll()
    roadieExploreRender(context)
    elements = objectGet(arrayGet(arrayGet(arrayGet(unittestMockEnd(), 1), 1), 0), 'elem')
    count = arrayLength(elements)
    unittestEqual(objectGet(objectGet(arrayGet(elements, count - 2), 'elem'), 'text'), 'H - keyboard help')
    unittestEqual(objectGet(arrayGet(elements, count - 3), 'svg'), 'rect')
    systemGlobalSet('vFile', null)
    systemGlobalSet('vExplore', null)
endfunction
unittestRunTest('testRoadieExploreRender')


# Press a key in a new simple plan 3D explorer - returns the context, the view before the key, and the key's call log
function testRoadieExploreKey(event):
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    context = roadieExploreContext(argsParse(roadieArguments), plan)
    unittestMockAll()
    roadieExploreRender(context)
    unittestMockEnd()
    view = objectGet(context, 'view')
    unittestMockAll()
    roadieExploreOnKeyDown(context, event)
    return [context, view, unittestMockEnd()]
endfunction


function testRoadieExploreOnKeyDown():
    # The view state keys - each re-renders the view
    for keyCase in [ \
        [{'key': '+', 'code': 'Equal', 'shiftKey': true}, {'zoom': 1.414}], \
        [{'key': '=', 'code': 'Equal'}, {'zoom': 1.414}], \
        [{'key': '-', 'code': 'Minus'}, {'zoom': 1}], \
        [{'key': '_', 'code': 'Minus', 'shiftKey': true}, {'zoom': 1}], \
        [{'key': 'q', 'code': 'KeyQ'}, {'azimuth': 20}], \
        [{'key': 'ArrowLeft', 'code': 'ArrowLeft', 'shiftKey': true}, {'azimuth': 20}], \
        [{'key': 'e', 'code': 'KeyE'}, {'azimuth': 40}], \
        [{'key': 'ArrowRight', 'code': 'ArrowRight', 'shiftKey': true}, {'azimuth': 40}], \
        [{'key': 'ArrowUp', 'code': 'ArrowUp', 'shiftKey': true}, {'tilt': 40}], \
        [{'key': 'ArrowDown', 'code': 'ArrowDown', 'shiftKey': true}, {'tilt': 30}], \
        [{'key': '[', 'code': 'BracketLeft'}, {'exaggeration': 1.25}], \
        [{'key': ']', 'code': 'BracketRight'}, {'exaggeration': 1.75}], \
        [{'key': 'g', 'code': 'KeyG'}, {'smooth': true}], \
        [{'key': 't', 'code': 'KeyT'}, {'tilt': 90}], \
        [{'key': 'n', 'code': 'KeyN'}, {'azimuth': 0}], \
        [{'key': 'h', 'code': 'KeyH'}, {'help': false}], \
        [{'key': '?', 'code': 'Slash', 'shiftKey': true}, {'help': false}] \
    ]:
        result = testRoadieExploreKey(arrayGet(keyCase, 0))
        expected = {'help': true, 'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5, 'zoom': 1, 'x': null, 'y': null, 'z': null, 'smooth': false}
        objectAssign(expected, arrayGet(keyCase, 1))
        unittestDeepEqual(objectGet(arrayGet(result, 0), 'state'), expected)
        unittestDeepEqual(arrayGet(arrayGet(arrayGet(result, 2), 0), 0), 'documentSetReset')
        unittestEqual(arrayLength(arrayGet(result, 2)), 2)
    endfor
endfunction
unittestRunTest('testRoadieExploreOnKeyDown')


function testRoadieExploreOnKeyDown_move():
    # The move keys move the view center an eighth of the view's width (or height, up and down) in the screen
    # directions - the moved center keeps its elevation
    for keyCase in [ \
        [{'key': 'ArrowLeft', 'code': 'ArrowLeft'}, -1, 0, 0], \
        [{'key': 'a', 'code': 'KeyA'}, -1, 0, 0], \
        [{'key': 'ArrowRight', 'code': 'ArrowRight'}, 1, 0, 0], \
        [{'key': 'd', 'code': 'KeyD'}, 1, 0, 0], \
        [{'key': 'ArrowUp', 'code': 'ArrowUp'}, 0, 1, 0], \
        [{'key': 'w', 'code': 'KeyW'}, 0, 1, 0], \
        [{'key': 'ArrowDown', 'code': 'ArrowDown'}, 0, -1, 0], \
        [{'key': 's', 'code': 'KeyS'}, 0, -1, 0], \
        [{'key': 'r', 'code': 'KeyR'}, 0, 0, 1], \
        [{'key': 'PageUp', 'code': 'PageUp'}, 0, 0, 1], \
        [{'key': 'f', 'code': 'KeyF'}, 0, 0, -1], \
        [{'key': 'PageDown', 'code': 'PageDown'}, 0, 0, -1] \
    ]:
        result = testRoadieExploreKey(arrayGet(keyCase, 0))
        state = objectGet(arrayGet(result, 0), 'state')
        view = arrayGet(result, 1)
        step = objectGet(view, 'width') / 8 / objectGet(view, 'scale')
        stepZ = objectGet(view, 'height') / 8 / (objectGet(view, 'scale') * 1.5)
        right = arrayGet(keyCase, 1)
        forward = arrayGet(keyCase, 2)
        x = 20 + (right * objectGet(view, 'cosAz') + forward * objectGet(view, 'sinAz')) * step
        y = 20 + (forward * objectGet(view, 'cosAz') - right * objectGet(view, 'sinAz')) * step
        unittestDeepEqual( \
            [objectGet(state, 'x'), objectGet(state, 'y'), objectGet(state, 'z')], \
            [ \
                mathRound(mathMax(0, mathMin(40, x)), 1), \
                mathRound(mathMax(0, mathMin(40, y)), 1), \
                mathRound(objectGet(view, 'zc') + arrayGet(keyCase, 3) * stepZ, 1) \
            ] \
        )
        unittestEqual(arrayLength(arrayGet(result, 2)), 2)
    endfor
endfunction
unittestRunTest('testRoadieExploreOnKeyDown_move')


function testRoadieExploreOnKeyDown_other():
    systemGlobalSet('vFile', 'a.json')
    systemGlobalSet('vExplore', true)
    systemGlobalSet('vZoom', 2)

    # Escape goes back to the report
    result = testRoadieExploreKey({'key': 'Escape', 'code': 'Escape'})
    unittestDeepEqual(arrayGet(result, 2), [['windowSetLocation', ["#var.vFile='a.json'"]]])

    # Browser shortcuts and other keys are ignored
    for event in [{'key': 'r', 'code': 'KeyR', 'metaKey': true}, {'key': 'r', 'code': 'KeyR', 'ctrlKey': true}, \
            {'key': 'r', 'code': 'KeyR', 'altKey': true}, {'key': 'z', 'code': 'KeyZ'}]:
        result = testRoadieExploreKey(event)
        unittestDeepEqual(arrayGet(result, 2), [])
        unittestEqual(objectGet(objectGet(arrayGet(result, 0), 'state'), 'z'), null)
    endfor

    # Reset returns to the initial view
    for event in [{'key': '0', 'code': 'Digit0'}, {'key': 'Home', 'code': 'Home'}]:
        plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
        context = roadieExploreContext(argsParse(roadieArguments), plan)
        unittestMockAll()
        roadieExploreRender(context)
        roadieExploreOnKeyDown(context, {'key': 'q', 'code': 'KeyQ'})
        roadieExploreOnKeyDown(context, {'key': 'w', 'code': 'KeyW'})
        roadieExploreOnKeyDown(context, event)
        unittestMockEnd()
        unittestDeepEqual(objectGet(context, 'state'), objectGet(context, 'initial'))
        unittestEqual(objectGet(objectGet(context, 'state'), 'zoom'), 2)
    endfor
    systemGlobalSet('vFile', null)
    systemGlobalSet('vExplore', null)
    systemGlobalSet('vZoom', null)
endfunction
unittestRunTest('testRoadieExploreOnKeyDown_other')


function testRoadieNewPageToken():
    # Each new page token counts up from the current one
    unittestMockAll()
    unittestEqual(roadieNewPageToken(), '1')
    unittestEqual(roadieNewPageToken(), '2')
    unittestEqual(sessionStorageGet(roadiePageTokenKey), '2')
    unittestDeepEqual(unittestMockEnd(), [ \
        ['sessionStorageSet', ['roadiePageToken', '1']], \
        ['sessionStorageSet', ['roadiePageToken', '2']] \
    ])
endfunction
unittestRunTest('testRoadieNewPageToken')


function testRoadieExploreOnKeyDown_stale():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    unittestMockAll()
    context = roadieExploreContext(argsParse(roadieArguments), plan)
    roadieExploreRender(context)

    # Another page (the report) is current - the stale explorer ignores its keys
    roadieNewPageToken()
    roadieExploreOnKeyDown(context, {'key': 'q', 'code': 'KeyQ'})
    unittestEqual(objectGet(objectGet(context, 'state'), 'azimuth'), 30)

    # The explorer's page is current
    sessionStorageSet(roadiePageTokenKey, objectGet(context, 'token'))
    roadieExploreOnKeyDown(context, {'key': 'q', 'code': 'KeyQ'})
    unittestEqual(objectGet(objectGet(context, 'state'), 'azimuth'), 20)
    unittestMockEnd()
endfunction
unittestRunTest('testRoadieExploreOnKeyDown_stale')


function testRoadieLabelX():
    # A 10-character, 10-pixel label is about 64 pixels wide - it's kept 4 pixels within the drawing
    unittestEqual(roadieLabelX('abcdefghij', 10, 200, 400), 200)
    unittestEqual(roadieLabelX('abcdefghij', 10, 0, 400), 36)
    unittestEqual(roadieLabelX('abcdefghij', 10, 400, 400), 364)
endfunction
unittestRunTest('testRoadieLabelX')


function testRoadieProfileView_labels():
    # Closely spaced turnouts - only the labels with room are drawn
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    structures = []
    station = 0
    while station < 40:
        arrayPush(structures, {'type': 'turnout', 'station': station, 'endStation': station + 1})
        station = station + 2
    endwhile
    option = arrayGet(objectGet(plan, 'options'), 0)
    objectSet(option, 'structures', structures)
    analysis = roadieAnalyze(plan, 0)
    svg = roadieProfileView(plan, option, analysis, 500, 300)
    labels = []
    for element in objectGet(svg, 'elem'):
        if objectGet(element, 'svg') == 'text' && objectGet(objectGet(element, 'elem'), 'text') == 'Turnout':
            arrayPush(labels, numberParseFloat(objectGet(objectGet(element, 'attr'), 'x')))
        endif
    endfor
    unittestEqual(arrayLength(labels) > 1, true)
    unittestEqual(arrayLength(labels) < arrayLength(structures), true)

    # The drawn labels don't overlap - each is at least its width (about 45 pixels) plus 4 pixels from the previous one
    for labelX, ixLabel in labels:
        if ixLabel > 0:
            unittestEqual(labelX - arrayGet(labels, ixLabel - 1) > 2 * 7 * 10 * 0.32 + 4, true)
        endif
    endfor
endfunction
unittestRunTest('testRoadieProfileView_labels')


