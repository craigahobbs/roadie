    unittestDeepEqual(roadieOptionsTable(plan, analyses, 0), [ \
        '| Option                | Length (ft) | Max Grade | Cut (cy) | Fill (cy) | Net (cy)      | Walls (sf) | Warnings | Cost Score | Relative |', \
        '|-----------------------|-------------|-----------|----------|-----------|---------------|------------|----------|-----------:|----------|', \
        '| **Main**              | 86          | 100.0%    | 353      | 299       | 11 export     | 53         | 18       |     **48** | +0%      |', \
        '| [Alt](#var.vOption=1) | 90          | 264.0%    | 19,237   | 102       | 16,634 export | 0          | 8        |    **471** | +890%    |' \
    ])
endfunction
unittestRunTest('testRoadieOptionsTable')


