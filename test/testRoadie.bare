function testRoadiePlanView_narrowOutlines():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    objectSet(objectGet(arrayGet(objectGet(plan, 'options'), 0), 'section'), 'width', 0.1)
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5, 'zoom': 4, 'x': 30, 'y': 10}, 420, 315)
    svg = roadiePlanView(plan, topo, [analysis], 0, 420, [['2', view, [20, 20]]])
    elements = objectGet(svg, 'elem')

    # The narrow road is also drawn as a highlighted centerline (a white halo under a colored line)
    highlight = []
    for element in elements:
        if systemType(element) == 'object' && objectGet(element, 'svg') == 'polyline' && \
                arrayIndexOf(['white', roadieRoadColor], objectGet(objectGet(element, 'attr'), 'stroke')) != -1:
            arrayPush(highlight, objectGet(objectGet(element, 'attr'), 'stroke-width'))
        endif
    endfor
    unittestDeepEqual(highlight, [6, 3])

    # The 3D view's area is a dashed outline, then its number is marked on the road (the plan view's center)
    area = arrayGet(elements, arrayLength(elements) - 3)
    unittestEqual(objectGet(area, 'svg'), 'polygon')
    unittestEqual(objectGet(objectGet(area, 'attr'), 'stroke-dasharray'), '5 4')
    unittestDeepEqual(objectGet(area, 'elem'), {'svg': 'title', 'elem': {'text': '3D view 2 area'}})
    marker = arrayGet(elements, arrayLength(elements) - 2)
    unittestDeepEqual([objectGet(marker, 'svg'), objectGet(objectGet(marker, 'attr'), 'cx'), objectGet(objectGet(marker, 'attr'), 'cy')], \
        ['circle', '210', '210'])
    label = arrayGet(elements, arrayLength(elements) - 1)
    unittestEqual(objectGet(objectGet(label, 'elem'), 'text'), '2')
endfunction
unittestRunTest('testRoadiePlanView_narrowOutlines')


function testRoadiePlanView_click():
