    unittestDeepEqual(roadieStructuresTable('feet', option, roadieAnalyze(plan, 0)), [ \
        '| Type          | Name | Station      | Side | Detail        |', \
        '|---------------|------|--------------|------|---------------|', \
        '| Existing road |      | 0+20 to 0+40 |      | Upgrade 20 ft |' \
    ])
