# testRoadie.bare - Roadie viewer application tests

include <args.bare>
include <dataTable.bare>
include <schemaDoc.bare>
include <unittest.bare>
include <unittestMock.bare>
include '../roadie.bare'
include 'testRoadieData.bare'


#
# Application pages
#


async function testRoadieMain_usage():
    unittestMockAll()
    roadieMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['documentSetTitle', ['Roadie']], \
        ['markdownPrint', [ \
            '# Roadie', \
            '', \
            'Roadie is a 3D viewer for road grading plan models. A road grading plan model contains the site', \
            'topography, the road start and end points, and one or more road plan options.', \
            '', \
            'To create a road plan model from a topographic map image, run:', \
            '', \
            '~~~', \
            'make plan FILE=<plan.png>', \
            '~~~', \
            '', \
            'To view a road plan model, run:', \
            '', \
            '~~~', \
            'make run FILE=<plan.json>', \
            '~~~', \
            '', \
            'Or, view a road plan model URL with the "file" argument: [Example](#var.vFile=\'example/example.json\')', \
            '', \
            '[Road plan model documentation](#var.vDoc=true)' \
        ]] \
    ])
endfunction
unittestRunTest('testRoadieMain_usage')


async function testRoadieMain_doc():
    systemGlobalSet('vDoc', true)
    unittestMockAll()
    roadieMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['documentSetTitle', ['Roadie Road Plan Model']], \
        ['markdownPrint', ['[Back](#var=)', '']], \
        ['markdownPrint', [schemaDocMarkdown(roadieTypes, 'RoadPlan')]] \
    ])
    systemGlobalSet('vDoc', null)
endfunction
unittestRunTest('testRoadieMain_doc')


async function testRoadieMain_fetchError():
    systemGlobalSet('vFile', 'missing.json')
    unittestMockAll({'systemFetch': {}})
    roadieMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', ['missing.json']], \
        ['documentSetTitle', ['Roadie']], \
        ['markdownPrint', ['# Roadie', '', '**Error:** Could not load the road plan "missing.json"']] \
    ])
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieMain_fetchError')


async function testRoadieMain_invalid():
    systemGlobalSet('vFile', 'invalid.json')
    unittestMockAll({'systemFetch': {'invalid.json': '{"title": "Invalid"}'}})
    roadieMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', ['invalid.json']], \
        ['documentSetTitle', ['Roadie']], \
        ['markdownPrint', ['# Roadie', '', '**Error:** The road plan "invalid.json" is invalid:', '', \
            markdownEscape('Required member "units" missing')]] \
    ])
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieMain_invalid')


async function testRoadieMain_simple():
    systemGlobalSet('vFile', 'simple.json')
    unittestMockAll({'systemFetch': {'simple.json': jsonStringify(testRoadiePlanSimple())}})
    roadieMain()
    log = unittestMockEnd()

    # Expected values
    args = argsParse(roadieArguments)
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    unittestDeepEqual(log, [ \
        ['systemFetch', ['simple.json']], \
        ['documentSetTitle', ['Simple Plan']], \
        ['markdownPrint', ['# Simple Plan', '']], \
        ['markdownPrint', ['## Plan Options', '']], \
        ['markdownPrint', [roadieOptionsTable(plan, [analysis], 0), '']], \
        ['markdownPrint', ['## Flat', '']], \
        ['markdownPrint', ['**Cost score: 14** - 40 m, 0.0% maximum grade, 0 design warnings', '']], \
        ['markdownPrint', ['### 3D View', '', roadieViewLinks(args), '']], \
        ['elementModelRender', [roadieView3D(plan, topo, 0, analysis, args, 976, 586)]], \
        ['markdownPrint', ['### Plan View', '']], \
        ['elementModelRender', [roadiePlanView(plan, topo, [analysis], 0, 976)]], \
        ['markdownPrint', ['### Profile', '']], \
        ['elementModelRender', [roadieProfileView(plan, arrayGet(objectGet(plan, 'options'), 0), analysis, 976, 320)]], \
        ['markdownPrint', ['### Cost', '', roadieScoreNote, '']], \
        ['markdownPrint', [roadieCostTable('meters', analysis), '']], \
        ['markdownPrint', ['### Design Warnings', '']], \
        ['markdownPrint', ['No design warnings.', '']], \
        ['markdownPrint', ['---', '', "[Road plan model documentation](#var.vDoc=true&var.vFile='simple.json')"]] \
    ])
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieMain_simple')


function testRoadieRender_complex():
    systemGlobalSet('vFile', 'plans/complex.json')
    args = argsParse(roadieArguments)
    plan = objectGet(roadieValidate(testRoadiePlanComplex()), 'plan')
    unittestMockAll()
    roadieRender(args, plan)
    log = unittestMockEnd()

    # Expected values
    topo = roadieTopo(plan)
    analyses = [roadieAnalyze(plan, 0), roadieAnalyze(plan, 1)]
    analysis = arrayGet(analyses, 0)
    option = arrayGet(objectGet(plan, 'options'), 0)
    warningLines = []
    for warning in objectGet(analysis, 'warnings'):
        arrayPush(warningLines, ['markdownPrint', ['- ' + markdownEscape(warning)]])
    endfor
    expected = [ \
        ['documentSetTitle', ['Complex Plan']], \
        ['markdownPrint', ['# Complex Plan', '']], \
        ['markdownPrint', [['A complex plan.'], '']], \
        ['markdownPrint', ['## Plan Options', '']], \
        ['markdownPrint', [roadieOptionsTable(plan, analyses, 0), '']], \
        ['markdownPrint', ['## Main', '']], \
        ['markdownPrint', [['The main option.'], '']], \
        ['markdownPrint', ['**Cost score: 48** - 86 ft, 100.0% maximum grade, 18 design warnings', '']], \
        ['markdownPrint', ['### 3D View', '', roadieViewLinks(args), '']], \
        ['elementModelRender', [roadieView3D(plan, topo, 0, analysis, args, 976, 586)]], \
        ['markdownPrint', ['### Plan View', '']], \
        ['elementModelRender', [roadiePlanView(plan, topo, analyses, 0, 976)]], \
        ['markdownPrint', ['### Profile', '']], \
        ['elementModelRender', [roadieProfileView(plan, option, analysis, 976, 320)]], \
        ['markdownPrint', ['### Cost', '', roadieScoreNote, '']], \
        ['markdownPrint', [roadieCostTable('feet', analysis), '']], \
        ['markdownPrint', ['### Design Warnings', '']] \
    ]
    arrayExtend(expected, warningLines)
    arrayExtend(expected, [ \
        ['markdownPrint', ['']], \
        ['markdownPrint', ['### Structures', '']], \
        ['markdownPrint', [roadieStructuresTable('feet', option, analysis), '']], \
        ['markdownPrint', ['### Source Map', '', '![The source topographic map](plans/map.png)', '']], \
        ['markdownPrint', ['---', '', "[Road plan model documentation](#var.vDoc=true&var.vFile='plans%2Fcomplex.json')"]] \
    ])
    unittestDeepEqual(log, expected)
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieRender_complex')


function testRoadieRender_alternate():
    systemGlobalSet('vFile', 'complex.json')
    systemGlobalSet('vOption', 5)
    args = argsParse(roadieArguments)
    plan = objectGet(roadieValidate(testRoadiePlanComplex()), 'plan')
    unittestMockAll()
    roadieRender(args, plan)
    log = unittestMockEnd()

    # The option is clamped to the last option, which has one design warning, no description, and no structures
    unittestDeepEqual(arrayGet(log, 5), ['markdownPrint', ['## Alt', '']])
    unittestDeepEqual(arrayGet(log, 6), \
        ['markdownPrint', ['**Cost score: 471** - 90 ft, 264.0% maximum grade, 8 design warnings', '']])
    unittestDeepEqual(arrayGet(log, arrayLength(log) - 2), \
        ['markdownPrint', ['### Source Map', '', '![The source topographic map](map.png)', '']])
    for entry in log:
        unittestEqual(arrayGet(arrayGet(entry, 1), 0) == '### Structures', false)
    endfor
    systemGlobalSet('vFile', null)
    systemGlobalSet('vOption', null)
endfunction
unittestRunTest('testRoadieRender_alternate')


function testRoadieRender_oneWarning():
    systemGlobalSet('vFile', 'simple.json')
    args = argsParse(roadieArguments)
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    objectSet(objectGet(plan, 'start'), 'x', -20)
    unittestMockAll()
    roadieRender(args, plan)
    log = unittestMockEnd()
    unittestDeepEqual(arrayGet(log, 5), \
        ['markdownPrint', ['**Cost score: 14** - 40 m, 0.0% maximum grade, 1 design warning', '']])
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieRender_oneWarning')


