function testRoadieView3D_narrow():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    objectSet(objectGet(arrayGet(objectGet(plan, 'options'), 0), 'section'), 'width', 0.1)
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5}, 400, 300)
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), 0.05)
    svg = roadieView3D(plan, topo, rows, 0, analysis, view)

    # The narrow road is also drawn as a highlighted centerline - a halo and a line for each of the 12 road intervals
    elements = objectGet(svg, 'elem')
    unittestEqual(arrayLength(elements), 16 + 12 * 3 + 12 * 2 + 1 + 4 + 1)
    halos = 0
    lines = 0
    for element in elements:
        if systemType(element) == 'object' && objectGet(element, 'svg') == 'polyline':
            stroke = objectGet(objectGet(element, 'attr'), 'stroke')
            halos = halos + if(stroke == 'white', 1, 0)
            lines = lines + if(stroke == roadieRoadColor, 1, 0)
        endif
    endfor
    unittestEqual(halos, 12)
    unittestEqual(lines, 12)
endfunction
unittestRunTest('testRoadieView3D_narrow')


function testRoadieCompass():
