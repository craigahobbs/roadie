    unittestEqual(roadieZoomStep(1.414, 1), 2)
    unittestEqual(roadieZoomStep(2, -1), 1.414)
    unittestEqual(roadieZoomStep(1, -1), 1)
    unittestEqual(roadieZoomStep(64, 1), 64)
