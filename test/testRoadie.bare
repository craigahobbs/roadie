#
# Report 3D views
#


# The simple plan with tall ridges on both sides of its road (which hide the road from low viewpoints)
function testRoadiePlanRidges():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    rows = objectGet(objectGet(plan, 'topography'), 'elevations')
    for row in [1, 3]:
        for col in [0, 1, 2, 3, 4]:
            arraySet(arrayGet(rows, row), col, 150)
        endfor
    endfor
    return plan
endfunction


function testRoadieChooseViewpoint():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    samples = objectGet(roadieAnalyze(plan, 0), 'samples')

    # The road runs east across a plane rising north - the overview looks north (upslope), at the lowest tilt
    unittestDeepEqual(roadieChooseViewpoint(topo, topo, samples, 0, 40, [35, 50], null), {'azimuth': 0, 'tilt': 35, 'hidden': 0})

    # A segment view turns toward its crosswise direction, at most 40 degrees from the base azimuth, on its side
    unittestDeepEqual(roadieChooseViewpoint(topo, topo, samples, 0, 40, [40], 30), {'azimuth': 0, 'tilt': 40, 'hidden': 0})
    unittestDeepEqual(roadieChooseViewpoint(topo, topo, samples, 0, 40, [40], 100), {'azimuth': 140, 'tilt': 40, 'hidden': 0})
    unittestDeepEqual(roadieChooseViewpoint(topo, topo, samples, 0, 40, [40], 300), {'azimuth': 340, 'tilt': 40, 'hidden': 0})

    # A single-sample segment uses the road's direction
    unittestDeepEqual(roadieChooseViewpoint(topo, topo, samples, 20, 20, [35], null), {'azimuth': 0, 'tilt': 35, 'hidden': 0})

    # The ridges hide the road at a low tilt from both sides - the viewpoint hiding the fewest wins
    ridgePlan = testRoadiePlanRidges()
    ridgeTopo = roadieTopo(ridgePlan)
    unittestDeepEqual(roadieChooseViewpoint(ridgeTopo, ridgeTopo, samples, 0, 40, [35], null), {'azimuth': 0, 'tilt': 35, 'hidden': 13})
    unittestDeepEqual(roadieChooseViewpoint(ridgeTopo, ridgeTopo, samples, 0, 40, [35, 90], null), {'azimuth': 0, 'tilt': 90, 'hidden': 0})
endfunction
unittestRunTest('testRoadieChooseViewpoint')


function testRoadieHiddenPoints():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    ridgeTopo = roadieTopo(testRoadiePlanRidges())
    points = [[20, 20, 102]]

    # Nothing is hidden from the top, or on open ground, or by ground beyond the topography
    unittestEqual(roadieHiddenPoints(ridgeTopo, points, 0, 90, 1.5), 0)
    unittestEqual(roadieHiddenPoints(topo, points, 0, 35, 1.5), 0)
    unittestEqual(roadieHiddenPoints(topo, [[20, 0, 100]], 0, 35, 1.5), 0)

    # The ridge hides the point - unless the view is steep enough to see over it
    unittestEqual(roadieHiddenPoints(ridgeTopo, points, 0, 35, 1.5), 1)
    unittestEqual(roadieHiddenPoints(ridgeTopo, points, 0, 85, 1.5), 0)
endfunction
unittestRunTest('testRoadieHiddenPoints')


function testRoadieFitViewpoint():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    samples = objectGet(roadieAnalyze(plan, 0), 'samples')
    footprint = []
    for sample in roadieSegmentSamples(samples, 0, 20):
        arrayExtend(footprint, roadieSamplePoints(sample, 5))
    endfor
    viewArgs = roadieFitViewpoint(topo, footprint, {'azimuth': 0, 'tilt': 40}, 400, 300)
    unittestEqual(objectGet(viewArgs, 'azimuth'), 0)
    unittestEqual(objectGet(viewArgs, 'tilt'), 40)
    unittestEqual(objectGet(viewArgs, 'zoom') > 1, true)

    # The footprint is centered in the view, filling 85% of its width
    view = roadieProjection(topo, viewArgs, 400, 300)
    coords = arrayGet(roadieProjectPoints(view, footprint), 0)
    pxs = []
    ixCoord = 0
    while ixCoord < arrayLength(coords):
        arrayPush(pxs, arrayGet(coords, ixCoord))
        ixCoord = ixCoord + 2
    endwhile
    arraySort(pxs)
    pxMin = arrayGet(pxs, 0)
    pxMax = arrayGet(pxs, arrayLength(pxs) - 1)
    unittestEqual(mathAbs((pxMin + pxMax) * 0.5 - 200) < 1, true)
    unittestEqual(mathAbs((pxMax - pxMin) - 0.85 * 400) < 2, true)
endfunction
unittestRunTest('testRoadieFitViewpoint')


function testRoadieReportViews():
    # The simple plan's road is wide enough to see in its overview - the only view
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), 5)
    views = roadieReportViews(plan, topo, rows, analysis, 0, 976, false)
    unittestEqual(arrayLength(views), 1)
    overview = arrayGet(views, 0)
    unittestDeepEqual([objectGet(overview, 'station'), objectGet(overview, 'endStation'), objectGet(overview, 'hidden'), \
        objectGet(overview, 'leftToRight')], [0, 40, 0, true])
    unittestEqual(objectGet(objectGet(overview, 'args'), 'azimuth'), 0)

    # A narrow road adds views of equal road segments, from the start to the end, in the overview's orientation
    objectSet(objectGet(arrayGet(objectGet(plan, 'options'), 0), 'section'), 'width', 0.1)
    analysis = roadieAnalyze(plan, 0)
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), 0.05)
    views = roadieReportViews(plan, topo, rows, analysis, 0, 976, false)
    unittestEqual(arrayLength(views), 3)
    baseAzimuth = objectGet(objectGet(arrayGet(views, 0), 'args'), 'azimuth')
    for view, ixView in views:
        if ixView > 0:
            unittestDeepEqual([objectGet(view, 'station'), objectGet(view, 'endStation')], [(ixView - 1) * 20, ixView * 20])
            unittestEqual(mathAbs(roadieAngleDifference(objectGet(objectGet(view, 'args'), 'azimuth'), baseAzimuth)) <= roadieMaxViewTurn, true)
            unittestEqual(objectGet(view, 'leftToRight'), true)
            unittestEqual(objectGet(objectGet(view, 'view'), 'zoom') > 1, true)
        endif
    endfor
endfunction
unittestRunTest('testRoadieReportViews')


function testRoadieReportUtilities():
    unittestDeepEqual(roadieGridSteps(5, 2), [0, 2, 4])
    unittestDeepEqual(roadieGridSteps(6, 2), [0, 2, 4, 5])
    unittestEqual(roadieAngleDifference(10, 350), 20)
    unittestEqual(roadieAngleDifference(350, 10), -20)
    unittestEqual(roadieAngleDifference(180, 0), -180)
    samples = [{'station': 0}, {'station': 5}, {'station': 10}]
    unittestDeepEqual(roadieSegmentSamples(samples, 5, 10), [{'station': 5}, {'station': 10}])
endfunction
unittestRunTest('testRoadieReportUtilities')


function testRoadieTerrainLinks():
    systemGlobalSet('vFile', 'a.json')
    note = " - faceted terrain is the plan's elevation grid; smooth terrain is interpolated between its points, so it " + \
        'looks smoother up close but is no more accurate'
    unittestEqual(roadieTerrainLinks(false), "Terrain: **Faceted** | [Smooth](#var.vFile='a.json'&var.vSmooth=true)" + note)
    unittestEqual(roadieTerrainLinks(true), "Terrain: [Faceted](#var.vFile='a.json') | **Smooth**" + note)
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieTerrainLinks')


function testRoadieCubic():
    unittestEqual(roadieCubic(0, 1, 2, 3, 0), 1)
    unittestEqual(roadieCubic(0, 1, 2, 3, 0.5), 1.5)
    unittestEqual(roadieCubic(0, 1, 2, 3, 1), 2)
    unittestEqual(roadieCubic(0, 0, 1, 1, 0.5), 0.5)
    unittestEqual(roadieCubic(1, 0, 0, 1, 0.5), -0.125)
endfunction
unittestRunTest('testRoadieCubic')


function testRoadieSmoothRows():
    rows = [ \
        [0, 0, 0, 0], \
        [0, 10, 0, 0], \
        [0, 0, 0, 0], \
        [0, 0, 0, 20] \
    ]

    # Two cells per grid cell side - the grid points keep their elevations
    smooth = roadieSmoothRows(rows, 1, 3, 0, 2, 2)
    unittestEqual(arrayLength(smooth), 5)
    unittestEqual(arrayLength(arrayGet(smooth, 0)), 5)
    unittestDeepEqual(arrayGet(smooth, 0), [0, 5.625, 10, 5.625, 0])
    unittestDeepEqual(arrayGet(arrayGet(smooth, 2), 2), 0)
    unittestDeepEqual(arrayGet(arrayGet(smooth, 4), 4), 0)

    # The interpolated elevations are clamped to each grid cell's corner elevations - the spline dips below zero
    # around the peak, and the clamp holds it at zero
    unittestEqual(roadieCubic(0, 10, 0, 0, 0.5) > 0, true)
    unittestDeepEqual(arrayGet(smooth, 3), [0, 0, 0, 0, 0])
    unittestEqual(arrayGet(arrayGet(smooth, 1), 1), 3.1640625)
endfunction
unittestRunTest('testRoadieSmoothRows')


function testRoadieView3D_minorContours():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), 5)

    # The minor contours (0.5 pixels wide) are drawn only where the terrain cells are large enough to read them
    for contourCase in [[400, true], [60, false]]:
        view = roadieProjection(topo, {'azimuth': 0, 'tilt': 90, 'exaggeration': 1}, arrayGet(contourCase, 0), 400)
        widths = {}
        for element in objectGet(roadieView3D(plan, topo, rows, 0, analysis, view), 'elem'):
            if systemType(element) == 'array' && objectGet(arrayGet(element, 0), 'svg') == 'polygon':
                for contour in arraySlice(element, 1):
                    objectSet(widths, '' + objectGet(objectGet(contour, 'attr'), 'stroke-width'), true)
                endfor
            endif
        endfor
        unittestEqual(objectHas(widths, '0.5'), arrayGet(contourCase, 1))
    endfor
endfunction
unittestRunTest('testRoadieView3D_minorContours')


function testRoadieView3D_smooth():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), 5)

    # The faceted view draws the 16 grid cells - the smooth view divides each into 4 x 4 cells
    for smoothCase in [[false, 16], [true, 16 * 16]]:
        view = roadieProjection(topo, {'azimuth': 0, 'tilt': 90, 'exaggeration': 1, 'smooth': arrayGet(smoothCase, 0)}, 400, 400)
        unittestEqual(objectGet(view, 'smooth'), arrayGet(smoothCase, 0))
        elements = objectGet(roadieView3D(plan, topo, rows, 0, analysis, view), 'elem')
        counts = testRoadie3DElementCounts(arraySlice(elements, 0, arrayLength(elements) - 5))
        unittestEqual(objectGet(counts, 'cells'), arrayGet(smoothCase, 1))
    endfor
endfunction
unittestRunTest('testRoadieView3D_smooth')


function testRoadieViewCaption():
    # The explore link omits the default tilt (35 degrees)
    overview = {'args': {'azimuth': 350, 'tilt': 35}, 'station': 0, 'endStation': 40, 'hidden': 0, 'leftToRight': true}
    unittestEqual(roadieViewCaption('meters', overview, 0, 1), \
        '**View 1 of 1: Overview** - the whole site, looking north (350°) from 35° above the horizon. The road runs left to ' + \
            'right from its start to its end. [Explore this view](#var.vAzimuth=350&var.vExplore=true)')

    # The terrain hides parts of the overview's road, shown in the views that follow
    objectSet(overview, 'hidden', 2)
    unittestEqual(roadieViewCaption('meters', overview, 0, 3), \
        '**View 1 of 3: Overview** - the whole site, looking north (350°) from 35° above the horizon. The road runs left to ' + \
            'right from its start to its end - the terrain hides parts of the road, shown in the views that follow. ' + \
            '[Explore this view](#var.vAzimuth=350&var.vExplore=true)')

    # A road segment view with parts of its road hidden
    segment = {'args': {'azimuth': 180, 'tilt': 55, 'zoom': 2}, 'station': 0, 'endStation': 20, 'hidden': 1, 'leftToRight': false}
    unittestEqual(roadieViewCaption('meters', segment, 1, 3), \
        '**View 2 of 3** - stations 0+000 to 0+020, looking south (180°) from 55° above the horizon. The road runs right to ' + \
            'left from its start to its end - the terrain hides parts of the road. ' + \
            '[Explore this view](#var.vAzimuth=180&var.vExplore=true&var.vTilt=55&var.vZoom=2)')
endfunction
unittestRunTest('testRoadieViewCaption')


