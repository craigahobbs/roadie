async function testRoadieMain_invalid():
    systemGlobalSet('vFile', 'invalid.json')
    unittestMockAll({'systemFetch': {'invalid.json': '{"title": "Invalid"}'}})
    roadieMain()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', ['invalid.json']], \
        ['documentSetTitle', ['Roadie']], \
        ['markdownPrint', ['# Roadie', '', '**Error:** The road plan "invalid.json" is invalid:', '', \
            markdownEscape('Required member "units" missing')]] \
    ])
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieMain_invalid')


# Create the expected render log of a report's plan view, profile, and 3D views
function testRoadieReportViewsLog(plan, analyses, ixOption):
    topo = roadieTopo(plan)
    analysis = arrayGet(analyses, ixOption)
    option = arrayGet(objectGet(plan, 'options'), ixOption)
    units = objectGet(plan, 'units')
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), objectGet(objectGet(option, 'section'), 'width') * 0.5)
    reportViews = roadieReportViews(plan, topo, rows, analysis, ixOption, 976, false)
    outlines = []
    for reportView, ixReportView in reportViews:
        if ixReportView > 0:
            middle = roadieSampleAt(objectGet(analysis, 'samples'), \
                (objectGet(reportView, 'station') + objectGet(reportView, 'endStation')) * 0.5)
            arrayPush(outlines, ['' + (ixReportView + 1), objectGet(reportView, 'view'), [objectGet(middle, 'x'), objectGet(middle, 'y')]])
        endif
    endfor
    log = [['markdownPrint', ['### Plan View', '']]]
    if arrayLength(outlines) > 0:
        arrayPush(log, ['markdownPrint', ['The numbered markers show the road segments of 3D views 2 through ' + \
            arrayLength(reportViews) + ', below - the dashed outlines show the areas they cover.', '']])
    endif
    exploreArgs = objectAssign({'explore': true}, objectGet(arrayGet(reportViews, 0), 'args'))
    arrayExtend(log, [ \
        ['elementModelRender', [roadiePlanView(plan, topo, analyses, ixOption, 976, outlines)]], \
        ['markdownPrint', ['### Profile', '']], \
        ['elementModelRender', [roadieProfileView(plan, option, analysis, 976, 320)]], \
        ['markdownPrint', ['### 3D Views', '', \
            argsLink(roadieArguments, 'Explore the plan in 3D', exploreArgs) + ' (full window, with keyboard controls)', '', \
            roadieTerrainLinks(false), '']] \
    ])
    for reportView, ixReportView in reportViews:
        arrayPush(log, ['markdownPrint', [roadieViewCaption(units, reportView, ixReportView, arrayLength(reportViews)), '']])
        arrayPush(log, ['elementModelRender', [roadieView3D(plan, topo, rows, ixOption, analysis, objectGet(reportView, 'view'))]])
    endfor
    return log
endfunction


async function testRoadieMain_simple():
    systemGlobalSet('vFile', 'simple.json')
    unittestMockAll({'systemFetch': {'simple.json': jsonStringify(testRoadiePlanSimple())}})
    roadieMain()
    log = unittestMockEnd()

    # Expected values
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    analysis = roadieAnalyze(plan, 0)
    expected = [ \
        ['systemFetch', ['simple.json']], \
        ['sessionStorageSet', ['roadiePageToken', '1']], \
        ['windowSetResize', ['<function>']], \
        ['documentSetTitle', ['Simple Plan']], \
        ['markdownPrint', ['# Simple Plan', '']], \
        ['markdownPrint', ['## Plan Options', '']], \
        ['markdownPrint', [roadieOptionsTable(plan, [analysis], 0), '']], \
        ['markdownPrint', ['## Flat', '']], \
        ['markdownPrint', ['**Cost score: 14** - 40 m, 0.0% maximum grade, 0 design warnings', '']] \
    ]
    arrayExtend(expected, testRoadieReportViewsLog(plan, [analysis], 0))
    arrayExtend(expected, [ \
        ['markdownPrint', ['### Cost', '', roadieScoreNote, '']], \
        ['markdownPrint', [roadieCostTable('meters', analysis), '']], \
        ['markdownPrint', ['### Design Warnings', '']], \
        ['markdownPrint', ['No design warnings.', '']], \
        ['markdownPrint', ['---', '', "[Road plan model documentation](#var.vDoc=true&var.vFile='simple.json')"]] \
    ])
    unittestDeepEqual(log, expected)

    # The simple plan's road is wide enough to see in the overview, so it's the only 3D view
    unittestEqual(arrayGet(arrayGet(arrayGet(log, 11), 1), 0), '### Profile')
    unittestEqual(arrayGet(arrayGet(arrayGet(log, 13), 1), 0), '### 3D Views')
    unittestEqual(stringStartsWith(arrayGet(arrayGet(arrayGet(log, 14), 1), 0), '**View 1 of 1: Overview**'), true)
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieMain_simple')


async function testRoadieMain_segments():
    systemGlobalSet('vFile', 'narrow.json')
    planValue = testRoadiePlanSimple()
    objectSet(objectGet(arrayGet(objectGet(planValue, 'options'), 0), 'section'), 'width', 0.1)
    unittestMockAll({'systemFetch': {'narrow.json': jsonStringify(planValue)}})
    roadieMain()
    log = unittestMockEnd()

    # The narrow road is too narrow to see in the overview, so the report adds road segment views, outlined on the
    # plan view
    plan = objectGet(roadieValidate(planValue), 'plan')
    analysis = roadieAnalyze(plan, 0)
    expected = testRoadieReportViewsLog(plan, [analysis], 0)
    unittestDeepEqual(arraySlice(log, 9, 9 + arrayLength(expected)), expected)
    unittestDeepEqual(arrayGet(log, 10), ['markdownPrint', ['The numbered markers show the road segments of 3D views 2 ' + \
        'through 3, below - the dashed outlines show the areas they cover.', '']])
    caption = '**View 2 of 3** - stations ' + roadieStation(0, 'meters') + ' to ' + roadieStation(20, 'meters')
    unittestEqual(stringStartsWith(arrayGet(arrayGet(arrayGet(log, 17), 1), 0), caption), true)
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieMain_segments')


async function testRoadieMain_explore():
    systemGlobalSet('vFile', 'simple.json')
    systemGlobalSet('vExplore', true)
    unittestMockAll({'systemFetch': {'simple.json': jsonStringify(testRoadiePlanSimple())}})
    roadieMain()
    log = unittestMockEnd()

    # The explorer renders its anchor, sets its key down and resize handlers, and renders its view
    unittestDeepEqual(arraySlice(log, 0, 6), [ \
        ['systemFetch', ['simple.json']], \
        ['sessionStorageSet', ['roadiePageToken', '1']], \
        ['documentSetTitle', ['Simple Plan - 3D']], \
        ['elementModelRender', [{'html': 'div', 'attr': {'id': 'roadie-explore', 'style': 'display: none;'}}]], \
        ['documentSetKeyDown', ['<function>']], \
        ['windowSetResize', ['<function>']] \
    ])
    unittestDeepEqual(arrayGet(log, 6), ['documentSetReset', ['roadie-explore']])
    unittestEqual(arrayGet(arrayGet(log, 7), 0), 'elementModelRender')
    unittestEqual(arrayLength(log), 8)
    systemGlobalSet('vFile', null)
    systemGlobalSet('vExplore', null)
endfunction
unittestRunTest('testRoadieMain_explore')


function testRoadieRender_complex():
    systemGlobalSet('vFile', 'plans/complex.json')
    args = argsParse(roadieArguments)
    plan = objectGet(roadieValidate(testRoadiePlanComplex()), 'plan')
    unittestMockAll()
    roadieRender(args, plan)
    log = unittestMockEnd()

    # Expected values
    analyses = [roadieAnalyze(plan, 0), roadieAnalyze(plan, 1)]
    analysis = arrayGet(analyses, 0)
    option = arrayGet(objectGet(plan, 'options'), 0)
    warningLines = []
    for warning in objectGet(analysis, 'warnings'):
        arrayPush(warningLines, ['markdownPrint', ['- ' + markdownEscape(warning)]])
    endfor
    expected = [ \
        ['sessionStorageSet', ['roadiePageToken', '1']], \
        ['windowSetResize', ['<function>']], \
        ['documentSetTitle', ['Complex Plan']], \
        ['markdownPrint', ['# Complex Plan', '']], \
        ['markdownPrint', [['A complex plan.'], '']], \
        ['markdownPrint', ['## Plan Options', '']], \
        ['markdownPrint', [roadieOptionsTable(plan, analyses, 0), '']], \
        ['markdownPrint', ['## Main', '']], \
        ['markdownPrint', [['The main option.'], '']], \
        ['markdownPrint', ['**Cost score: 48** - 86 ft, 100.0% maximum grade, 18 design warnings', '']] \
    ]
    arrayExtend(expected, testRoadieReportViewsLog(plan, analyses, 0))
    arrayExtend(expected, [ \
        ['markdownPrint', ['### Cost', '', roadieScoreNote, '']], \
        ['markdownPrint', [roadieCostTable('feet', analysis), '']], \
        ['markdownPrint', ['### Design Warnings', '']] \
    ])
    arrayExtend(expected, warningLines)
    arrayExtend(expected, [ \
        ['markdownPrint', ['']], \
        ['markdownPrint', ['### Structures', '']], \
        ['markdownPrint', [roadieStructuresTable('feet', option, analysis), '']], \
        ['markdownPrint', ['### Source Map', '']], \
        ['elementModelRender', [{'html': 'p', 'elem': {'html': 'img', 'attr': { \
            'src': 'plans/map.png', 'alt': 'The source topographic map', 'style': 'max-width: 100%; height: auto;'}}}]], \
        ['markdownPrint', ['---', '', "[Road plan model documentation](#var.vDoc=true&var.vFile='plans%2Fcomplex.json')"]] \
    ])
    unittestDeepEqual(log, expected)
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieRender_complex')


function testRoadieRender_alternate():
    systemGlobalSet('vFile', 'complex.json')
    systemGlobalSet('vOption', 5)
    args = argsParse(roadieArguments)
    plan = objectGet(roadieValidate(testRoadiePlanComplex()), 'plan')
    unittestMockAll()
    roadieRender(args, plan)
    log = unittestMockEnd()

    # The option is clamped to the last option, which has one design warning, no description, and no structures
    unittestDeepEqual(arrayGet(log, 7), ['markdownPrint', ['## Alt', '']])
    unittestDeepEqual(arrayGet(log, 8), \
        ['markdownPrint', ['**Cost score: 471** - 90 ft, 264.0% maximum grade, 8 design warnings', '']])
    unittestDeepEqual(arrayGet(log, arrayLength(log) - 3), ['markdownPrint', ['### Source Map', '']])
    unittestDeepEqual(arrayGet(log, arrayLength(log) - 2), ['elementModelRender', [{'html': 'p', 'elem': {'html': 'img', 'attr': { \
        'src': 'map.png', 'alt': 'The source topographic map', 'style': 'max-width: 100%; height: auto;'}}}]])
    for entry in log:
        unittestEqual(arrayGet(arrayGet(entry, 1), 0) == '### Structures', false)
    endfor
    systemGlobalSet('vFile', null)
    systemGlobalSet('vOption', null)
endfunction
unittestRunTest('testRoadieRender_alternate')


function testRoadieWindowWidthWide():
    return 2000
endfunction


function testRoadieWindowWidthNarrow():
    return 300
endfunction


# Assert that a resize handler re-renders the road plan when the view width changed
function testRoadieResizeRenders(resizeFn, args, plan):
    systemGlobalSet('roadieRenderWidth', 500)
    unittestMockAll()
    roadieRender(args, plan)
    expected = unittestMockEnd()
    systemGlobalSet('roadieRenderWidth', 500)
    unittestMockAll()
    resizeFn()
    unittestDeepEqual(unittestMockEnd(), expected)
    unittestEqual(systemGlobalGet('roadieRenderWidth'), 976)
endfunction


function testRoadieViewWidth():
    # The window width less the body margins, from 400 to 1200 pixels
    unittestMockAll()
    unittestEqual(roadieViewWidth(), 976)
    unittestMockEnd()
    unittestMockOne('windowWidth', testRoadieWindowWidthWide)
    unittestEqual(roadieViewWidth(), 1200)
    unittestMockEnd()
    unittestMockOne('windowWidth', testRoadieWindowWidthNarrow)
    unittestEqual(roadieViewWidth(), 400)
    unittestMockEnd()
endfunction
unittestRunTest('testRoadieViewWidth')


function testRoadieOnResize():
    systemGlobalSet('vFile', 'simple.json')
    args = argsParse(roadieArguments)
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')

    # The view width is unchanged - no re-render
    systemGlobalSet('roadieRenderWidth', 976)
    unittestMockAll()
    roadieOnResize(args, plan)
    unittestDeepEqual(unittestMockEnd(), [])

    # The view width changed - re-render
    testRoadieResizeRenders(systemPartial(roadieOnResize, args, plan), args, plan)

    systemGlobalSet('roadieRenderWidth', null)
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieOnResize')


function testRoadieRender_resize():
    systemGlobalSet('vFile', 'simple.json')
    args = argsParse(roadieArguments)
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')

    # The render records its view width and sets the window resize handler
    unittestMockAll()
    roadieRender(args, plan)
    resizeFn = arrayGet(arrayGet(arrayGet(unittestMockEnd(), 1), 1), 0)
    unittestEqual(systemGlobalGet('roadieRenderWidth'), 976)
    testRoadieResizeRenders(resizeFn, args, plan)

    systemGlobalSet('roadieRenderWidth', null)
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieRender_resize')


function testRoadieRender_oneWarning():
    systemGlobalSet('vFile', 'simple.json')
    args = argsParse(roadieArguments)
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    objectSet(objectGet(plan, 'start'), 'x', -20)
    unittestMockAll()
    roadieRender(args, plan)
    log = unittestMockEnd()
    unittestDeepEqual(arrayGet(log, 7), \
        ['markdownPrint', ['**Cost score: 14** - 40 m, 0.0% maximum grade, 1 design warning', '']])
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieRender_oneWarning')


