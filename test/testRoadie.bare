function testRoadieViewLinks():
    systemGlobalSet('vFile', 'a.json')
    args = argsParse(roadieArguments)
    unittestEqual(roadieViewLinks(args), \
        "Rotate [Left](#var.vAzimuth=15&var.vFile='a.json') | [Right](#var.vAzimuth=45&var.vFile='a.json')" + \
        " — Tilt [Up](#var.vFile='a.json'&var.vTilt=45) | [Down](#var.vFile='a.json'&var.vTilt=25)" + \
        " — Exaggeration [More](#var.vExaggeration=2&var.vFile='a.json') | [Less](#var.vExaggeration=1&var.vFile='a.json')" + \
        " — [Top](#var.vAzimuth=0&var.vFile='a.json'&var.vTilt=90) | [Reset](#var.vFile='a.json')")
    systemGlobalSet('vFile', null)
endfunction
unittestRunTest('testRoadieViewLinks')


function testRoadieViewLinks_limits():
    systemGlobalSet('vAzimuth', 345)
    systemGlobalSet('vTilt', 90)
    systemGlobalSet('vExaggeration', 5)
    args = argsParse(roadieArguments)
    unittestEqual(roadieViewLinks(args), \
        "Rotate [Left](#var.vAzimuth=330&var.vExaggeration=5&var.vTilt=90) | [Right](#var.vAzimuth=0&var.vExaggeration=5&var.vTilt=90)" + \
        " — Tilt [Up](#var.vAzimuth=345&var.vExaggeration=5&var.vTilt=90) | [Down](#var.vAzimuth=345&var.vExaggeration=5&var.vTilt=80)" + \
        " — Exaggeration [More](#var.vAzimuth=345&var.vExaggeration=5&var.vTilt=90) | [Less](#var.vAzimuth=345&var.vExaggeration=4.5&var.vTilt=90)" + \
        " — [Top](#var.vAzimuth=0&var.vExaggeration=5&var.vTilt=90) | [Reset](#var=)")
    systemGlobalSet('vAzimuth', null)
    systemGlobalSet('vTilt', null)
    systemGlobalSet('vExaggeration', null)
endfunction
unittestRunTest('testRoadieViewLinks_limits')


