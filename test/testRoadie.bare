        'x': 20, 'y': 20, 'z': 100, 'dx': 1, 'dy': 0, \
        'left': {'offset': 2, 'drop': 2}, \
        'right': {'offset': 3, 'drop': -1.5} \
    }
    unittestDeepEqual(roadieSamplePoints(sample, 5), [[20, 27, 102], [20, 25, 100], [20, 15, 100], [20, 12, 98.5]])
endfunction
unittestRunTest('testRoadieSamplePoints')


#
# 3D view
#


function testRoadieProjection():
    topo = roadieTopo(testRoadiePlanSimple())
    view = roadieProjection(topo, {'azimuth': 0, 'tilt': 90, 'exaggeration': 1}, 100, 100)
    unittestEqual(mathRound(objectGet(view, 'scale'), 6), 1.626346)
    unittestEqual(mathRound(objectGet(view, 'uMid'), 6), 0)
    unittestEqual(mathRound(objectGet(view, 'vMid'), 6), 0)
    point = roadieProject(view, 20, 20, 102)
    unittestDeepEqual([mathRound(arrayGet(point, 0), 6), mathRound(arrayGet(point, 1), 6), mathRound(arrayGet(point, 2), 6)], [50, 50, 0])
    point = roadieProject(view, 40, 40, 104)
    unittestDeepEqual([mathRound(arrayGet(point, 0), 6), mathRound(arrayGet(point, 1), 6), mathRound(arrayGet(point, 2), 6)], [82.526912, 17.473088, -2])

    # Side view from the east (looking west) - north is screen right, farther west is deeper
    view = roadieProjection(topo, {'azimuth': 270, 'tilt': 0, 'exaggeration': 2}, 100, 100)
    point = roadieProject(view, 0, 40, 102)
    unittestDeepEqual([mathRound(arrayGet(point, 0), 6), mathRound(arrayGet(point, 1), 6), mathRound(arrayGet(point, 2), 6)], [82.526912, 47.165093, 19.923894])

    projected = roadieProjectPoints(view, [[0, 40, 102], [40, 0, 102]])
    unittestEqual(mathRound(arrayGet(projected, 1), 6), 0)
    unittestEqual(arrayLength(arrayGet(projected, 0)), 4)

    # The scale doesn't change as the view rotates
    for azimuth in [0, 30, 45, 60, 90, 135, 210, 330]:
        view = roadieProjection(topo, {'azimuth': azimuth, 'tilt': 35, 'exaggeration': 1.5}, 100, 100)
        unittestEqual(mathRound(objectGet(view, 'scale'), 6), 1.626346)
    endfor
endfunction
unittestRunTest('testRoadieProjection')


function testRoadieCompareDepth():
    items = [[1, 'a'], [3, 'b'], [2, 'c']]
    arraySort(items, roadieCompareDepth)
    unittestDeepEqual(items, [[3, 'b'], [2, 'c'], [1, 'a']])
endfunction
unittestRunTest('testRoadieCompareDepth')


function testRoadie3DPolygon():
    topo = roadieTopo(testRoadiePlanSimple())
    view = roadieProjection(topo, {'azimuth': 0, 'tilt': 90, 'exaggeration': 1}, 100, 100)
    item = roadie3DPolygon(view, [[0, 0, 102], [40, 0, 102], [40, 40, 102], [0, 40, 102]], [100, 100, 100], 3, 'Tip')
    fill = roadieRGB([100, 100, 100], 0.5 + 0.6 * 0.7071)
    unittestEqual(mathRound(arrayGet(item, 0), 6), -3)
    unittestDeepEqual(arrayGet(item, 1), roadieSvgPolygon([17.5, 82.5, 82.5, 82.5, 82.5, 17.5, 17.5, 17.5], fill, fill, 0.5, 'Tip'))
endfunction
unittestRunTest('testRoadie3DPolygon')


function testRoadieFinishedRows():
    plan = testRoadiePlanSimple()
    option = arrayGet(objectGet(plan, 'options'), 0)
    objectSet(objectGet(option, 'section'), 'width', 18)
    for point in objectGet(option, 'alignment'):
        objectSet(point, 'z', 101)
    endfor
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), 9)
    rounded = []
    for row in rows:
        roundedRow = []
        for z in row:
            arrayPush(roundedRow, mathRound(z, 6))
        endfor
        arrayPush(rounded, roundedRow)
    endfor
    unittestDeepEqual(rounded, [ \
        [104, 104, 104, 104, 104], \
        [102, 102, 102, 102, 102], \
        [101, 101, 101, 101, 101], \
        [101, 101, 101, 101, 101], \
        [100, 100, 100, 100, 100] \
    ])

    # The original rows are unchanged
    unittestEqual(arrayGet(arrayGet(objectGet(topo, 'rows'), 1), 0), 103)
endfunction
unittestRunTest('testRoadieFinishedRows')


function testRoadieView3D():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    args = {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5}
    svg = roadieView3D(plan, topo, 0, analysis, args, 400, 300)
    unittestEqual(objectGet(svg, 'svg'), 'svg')
    unittestEqual(objectGet(objectGet(svg, 'attr'), 'aria-label'), '3D view of the Flat road plan option')

    # 16 terrain cells, 12 road intervals of surface and two side slopes, two markers, and the compass
    elements = objectGet(svg, 'elem')
    unittestEqual(arrayLength(elements), 16 + 12 * 3 + 4 + 1)
    unittestEqual(objectGet(arrayGet(elements, 52), 'svg'), 'polyline')
    unittestEqual(objectGet(objectGet(arrayGet(elements, 53), 'elem'), 'text'), 'Start')
    unittestEqual(objectGet(objectGet(arrayGet(elements, 55), 'elem'), 'text'), 'End')
endfunction
unittestRunTest('testRoadieView3D')


function testRoadieCompass():
    topo = roadieTopo(testRoadiePlanSimple())
    view = roadieProjection(topo, {'azimuth': 0, 'tilt': 90, 'exaggeration': 1}, 100, 100)
    compass = roadieCompass(view, 64, 36)
    unittestDeepEqual(arrayGet(compass, 0), \
        {'svg': 'circle', 'attr': {'cx': 64, 'cy': 36, 'r': 22, 'fill': 'white', 'fill-opacity': 0.8, 'stroke': '#888'}})
    unittestDeepEqual(arrayGet(compass, 1), roadieSvgPolygon([64, 18, 70, 36, 58, 36], '#c0392b', '#c0392b', 1))
    unittestDeepEqual(arrayGet(compass, 2), roadieSvgText('N', 64, 48, 11, 'middle', '#333', true))
endfunction
unittestRunTest('testRoadieCompass')


#
# Plan and profile views
#


function testRoadiePlanView():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    svg = roadiePlanView(plan, topo, [analysis], 0, 420)
    unittestEqual(objectGet(objectGet(svg, 'attr'), 'width'), 420)
    unittestEqual(objectGet(objectGet(svg, 'attr'), 'height'), 420)
    unittestEqual(objectGet(objectGet(svg, 'attr'), 'aria-label'), 'Plan view of the Flat road plan option')

    # The first elements are the minor and index contour paths
    elements = objectGet(svg, 'elem')
    unittestEqual(objectGet(objectGet(arrayGet(elements, 0), 'attr'), 'stroke'), '#b89a72')
    unittestEqual(objectGet(objectGet(arrayGet(elements, 1), 'attr'), 'stroke'), '#8a6a45')
endfunction
unittestRunTest('testRoadiePlanView')


function testRoadieProfileView():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    analysis = roadieAnalyze(plan, 0)
    svg = roadieProfileView(plan, arrayGet(objectGet(plan, 'options'), 0), analysis, 500, 300)
    unittestEqual(objectGet(objectGet(svg, 'attr'), 'width'), 500)
    unittestEqual(objectGet(objectGet(svg, 'attr'), 'height'), 300)
    unittestEqual(objectGet(objectGet(svg, 'attr'), 'aria-label'), 'Profile of the Flat road plan option')
endfunction
unittestRunTest('testRoadieProfileView')


function testRoadieAlignmentPointAt():
    analysis = {'alignment': [{'station': 0, 'z': 1}, {'station': 10, 'z': 2}]}
    unittestDeepEqual(roadieAlignmentPointAt(analysis, 0), {'station': 0, 'z': 1})
    unittestDeepEqual(roadieAlignmentPointAt(analysis, 5), {'station': 10, 'z': 2})
    unittestEqual(roadieAlignmentPointAt(analysis, 15), null)
endfunction
unittestRunTest('testRoadieAlignmentPointAt')
