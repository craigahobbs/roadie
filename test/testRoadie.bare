    fill = roadieRGB([100, 100, 100], 0.5 + 0.6 * 0.7071)
    unittestEqual(mathRound(arrayGet(item, 0), 6), 2.3)
    unittestDeepEqual(arrayGet(item, 1), roadieSvgPolygon([25.1, 74.9, 74.9, 74.9, 74.9, 25.1, 25.1, 25.1], fill, fill, 0.5, 'Tip'))
endfunction
unittestRunTest('testRoadie3DPolygon')


function testRoadieFinishedRows():
    plan = testRoadiePlanSimple()
    option = arrayGet(objectGet(plan, 'options'), 0)
    objectSet(objectGet(option, 'section'), 'width', 18)
    for point in objectGet(option, 'alignment'):
        objectSet(point, 'z', 101)
    endfor
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), 9)
    rounded = []
    for row in rows:
        roundedRow = []
        for z in row:
            arrayPush(roundedRow, mathRound(z, 6))
        endfor
        arrayPush(rounded, roundedRow)
    endfor
    unittestDeepEqual(rounded, [ \
        [104, 104, 104, 104, 104], \
        [102, 102, 102, 102, 102], \
        [101, 101, 101, 101, 101], \
        [101, 101, 101, 101, 101], \
        [100, 100, 100, 100, 100] \
    ])

    # The original rows are unchanged
    unittestEqual(arrayGet(arrayGet(objectGet(topo, 'rows'), 1), 0), 103)
endfunction
unittestRunTest('testRoadieFinishedRows')


# Count a 3D view's depth-sorted items - terrain cells (a polygon and contour paths), contour paths, station labels
# (a circle and text), and polygons
function testRoadie3DElementCounts(elements):
    counts = {'cells': 0, 'contours': 0, 'labels': [], 'polygons': 0}
    for element in elements:
        if systemType(element) == 'object':
            objectSet(counts, 'polygons', objectGet(counts, 'polygons') + if(objectGet(element, 'svg') == 'polygon', 1, 0))
        elif objectGet(arrayGet(element, 0), 'svg') == 'circle':
            arrayPush(objectGet(counts, 'labels'), objectGet(objectGet(arrayGet(element, 1), 'elem'), 'text'))
        else:
            objectSet(counts, 'cells', objectGet(counts, 'cells') + 1)
            for contour in arraySlice(element, 1):
                objectSet(counts, 'contours', objectGet(counts, 'contours') + if(objectGet(contour, 'svg') == 'path', 1, 0))
            endfor
        endif
    endfor
    return counts
endfunction


function testRoadieView3D():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5}, 400, 300)
    rows = roadieFinishedRows(topo, objectGet(analysis, 'samples'), 5)
    svg = roadieView3D(plan, topo, rows, 0, analysis, view)
    unittestEqual(objectGet(svg, 'svg'), 'svg')
    unittestEqual(objectGet(objectGet(svg, 'attr'), 'aria-label'), '3D view of the Flat road plan option')

    # 16 terrain cells, 12 road intervals of surface and two side slopes, and a station label (20 m), depth-sorted,
    # then two markers and the compass
    elements = objectGet(svg, 'elem')
    unittestEqual(arrayLength(elements), 16 + 12 * 3 + 1 + 4 + 1)
    counts = testRoadie3DElementCounts(arraySlice(elements, 0, arrayLength(elements) - 5))
    unittestDeepEqual(counts, {'cells': 16, 'contours': 16, 'labels': ['0+020'], 'polygons': 36})
    unittestEqual(objectGet(arrayGet(elements, 53), 'svg'), 'polyline')
    unittestEqual(objectGet(objectGet(arrayGet(elements, 54), 'elem'), 'text'), 'Start')
    unittestEqual(objectGet(objectGet(arrayGet(elements, 56), 'elem'), 'text'), 'End')
endfunction
unittestRunTest('testRoadieView3D')


function testRoadieView3D_zoom():
    plan = objectGet(roadieValidate(testRoadiePlanSimple()), 'plan')
    topo = roadieTopo(plan)
    analysis = roadieAnalyze(plan, 0)
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5, 'zoom': 4, 'x': 30, 'y': 10}, 400, 300)
