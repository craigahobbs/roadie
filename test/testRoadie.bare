#
# 3D view
#


function testRoadieProjection():
    topo = roadieTopo(testRoadiePlanSimple())
    view = roadieProjection(topo, {'azimuth': 0, 'tilt': 90, 'exaggeration': 1}, 100, 100)
    unittestEqual(mathRound(objectGet(view, 'scale'), 6), 1.244486)
    point = roadieProject(view, 20, 20, 102)
    unittestDeepEqual([mathRound(arrayGet(point, 0), 6), mathRound(arrayGet(point, 1), 6), mathRound(arrayGet(point, 2), 6)], [50, 50, 5.3])
    point = roadieProject(view, 40, 40, 104)
    unittestDeepEqual([mathRound(arrayGet(point, 0), 6), mathRound(arrayGet(point, 1), 6), mathRound(arrayGet(point, 2), 6)], [74.889727, 25.110273, 3.3])

    # Side view from the east (looking west) - north is screen right, farther west is deeper
    view = roadieProjection(topo, {'azimuth': 270, 'tilt': 0, 'exaggeration': 2}, 100, 100)
    point = roadieProject(view, 0, 40, 102)
    unittestDeepEqual([mathRound(arrayGet(point, 0), 6), mathRound(arrayGet(point, 1), 6), mathRound(arrayGet(point, 2), 6)], [74.889727, 47.60015, 20.821598])

    projected = roadieProjectPoints(view, [[0, 40, 102], [40, 0, 102]])
    unittestEqual(mathRound(arrayGet(projected, 1), 6), 0.897704)
    unittestEqual(arrayLength(arrayGet(projected, 0)), 4)

    # The scale doesn't change as the view rotates
    for azimuth in [0, 30, 45, 60, 90, 135, 210, 330]:
        view = roadieProjection(topo, {'azimuth': azimuth, 'tilt': 35, 'exaggeration': 1.5}, 100, 100)
        unittestEqual(mathRound(objectGet(view, 'scale'), 6), 1.244486)
    endfor

    # The view's height fits the topography (a low tilt), up to the maximum height (a top view)
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 10, 'exaggeration': 1.5}, 400, 300)
    unittestEqual(objectGet(view, 'height'), 240)
    unittestEqual(mathRound(objectGet(view, 'zc'), 6), 107.2)
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 90, 'exaggeration': 1.5}, 400, 300)
    unittestEqual(objectGet(view, 'height'), 300)
    unittestEqual(mathRound(objectGet(view, 'scale'), 6), 4.90474)
endfunction
unittestRunTest('testRoadieProjection')


function testRoadieProjection_zoom():
    topo = roadieTopo(testRoadiePlanSimple())
    fit = roadieProjection(topo, {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5}, 400, 300)
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5, 'zoom': 4, 'x': 30, 'y': 10}, 400, 300)
    unittestEqual(objectGet(view, 'zoom'), 4)
    unittestEqual(mathRound(objectGet(view, 'scale') / objectGet(fit, 'scale'), 6), 4)
    unittestEqual(objectGet(view, 'height'), 300)

    # The view center point is at the view center
    point = roadieProject(view, 30, 10, roadieElevation(topo, 30, 10))
    unittestDeepEqual([mathRound(arrayGet(point, 0), 6), mathRound(arrayGet(point, 1), 6)], [200, objectGet(view, 'cy')])

    # A low view's fit height is short - a zoomed or moved view is up to the maximum height, trimmed to its landscape
    # (and the marker poles), so the landscape isn't surrounded by empty bands
    args = {'azimuth': 80, 'tilt': 10, 'exaggeration': 1.5}
    unittestEqual(objectGet(roadieProjection(topo, args, 400, 300), 'height'), 240)
    for viewArgs, ixViewArgs in [{'zoom': 1.414}, {'z': 110}]:
        lowView = roadieProjection(topo, objectAssign(objectCopy(args), viewArgs), 400, 300)
        unittestEqual(objectGet(lowView, 'height'), arrayGet([271, 238], ixViewArgs))
        upRange = roadieViewUpRange(lowView, topo)
        landscapeTop = objectGet(lowView, 'cy') - arrayGet(upRange, 1) * objectGet(lowView, 'scale')
        landscapeBottom = objectGet(lowView, 'cy') - arrayGet(upRange, 0) * objectGet(lowView, 'scale')
        unittestEqual(landscapeTop > 24 && landscapeBottom < objectGet(lowView, 'height'), true)
    endfor

    # A landscape out of view is the maximum height, with the view center at its middle
    lowView = roadieProjection(topo, objectAssign(objectCopy(args), {'z': 10000}), 400, 300)
    unittestDeepEqual([objectGet(lowView, 'height'), objectGet(lowView, 'cy')], [300, 150])

    # A view center off the topography is moved to its edge, on the ground - an explicit elevation is kept
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5, 'zoom': 0.5, 'x': 100, 'y': 100}, 400, 300)
    unittestEqual(objectGet(view, 'zoom'), 1)
    unittestDeepEqual([objectGet(view, 'xc'), objectGet(view, 'yc'), objectGet(view, 'zc')], [40, 40, 104])
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5, 'zoom': 100, 'z': 90}, 400, 300)
    unittestEqual(objectGet(view, 'zoom'), roadieMaxZoom)
    unittestDeepEqual([objectGet(view, 'xc'), objectGet(view, 'yc'), objectGet(view, 'zc')], [20, 20, 90])
endfunction
unittestRunTest('testRoadieProjection_zoom')


function testRoadieUnproject():
    topo = roadieTopo(testRoadiePlanSimple())
    view = roadieProjection(topo, {'azimuth': 30, 'tilt': 35, 'exaggeration': 1.5, 'zoom': 2}, 400, 300)

    # Unprojecting a projected ground point finds the ground point
    point = roadieProject(view, 30, 10, roadieElevation(topo, 30, 10))
    ground = roadieUnproject(view, topo, arrayGet(point, 0), arrayGet(point, 1))
    unittestDeepEqual([mathRound(arrayGet(ground, 0), 3), mathRound(arrayGet(ground, 1), 3)], [30, 10])

    # The point at an elevation
    point = roadieProject(view, 5, 35, 110)
    atZ = roadieUnprojectZ(view, arrayGet(point, 0), arrayGet(point, 1), 110)
    unittestDeepEqual([mathRound(arrayGet(atZ, 0), 6), mathRound(arrayGet(atZ, 1), 6)], [5, 35])

    # Pixels off the topography are clamped to it
    unittestDeepEqual(roadieUnproject(view, topo, -10000, 150), [0, 40])
endfunction
unittestRunTest('testRoadieUnproject')


function testRoadieCompareDepth():
    items = [[1, 'a'], [3, 'b'], [2, 'c']]
    arraySort(items, roadieCompareDepth)
    unittestDeepEqual(items, [[3, 'b'], [2, 'c'], [1, 'a']])
endfunction
unittestRunTest('testRoadieCompareDepth')


function testRoadieSortDepth():
    # Fewer than two items
    unittestDeepEqual(roadieSortDepth([]), [])
    unittestDeepEqual(roadieSortDepth([[1, 'a']]), [[1, 'a']])

    # Equal depths keep their order
    unittestDeepEqual(roadieSortDepth([[2, 'a'], [2, 'b']]), [[2, 'a'], [2, 'b']])

    # The same order as a stable sort with roadieCompareDepth
    items = []
    ixItem = 0
    while ixItem < 50:
        arrayPush(items, [(ixItem * 37) % 11 + if(ixItem % 3 == 0, 0.5, 0), ixItem])
        ixItem = ixItem + 1
    endwhile
    expected = arrayCopy(items)
    arraySort(expected, roadieCompareDepth)
    unittestDeepEqual(roadieSortDepth(items), expected)
endfunction
unittestRunTest('testRoadieSortDepth')


function testRoadie3DPolygon():
    topo = roadieTopo(testRoadiePlanSimple())
